<!-- Language Switcher Component -->
<%
const availableLanguages = [
    { code: 'es', name: 'Español', flag: '🇪🇸' },
    { code: 'en', name: 'English', flag: '🇺🇸' },
    { code: 'fr', name: 'Français', flag: '🇫🇷' },
    { code: 'ro', name: 'Română', flag: '🇲🇩' }
];

const currentLang = typeof language !== 'undefined' ? language : 'es';
const currentLangData = availableLanguages.find(lang => lang.code === currentLang) || availableLanguages[0];
const uniqueId = 'lang-' + Math.random().toString(36).substr(2, 9);
%>

<div class="language-switcher-container" data-switcher-id="<%= uniqueId %>">
    <div>
        <button type="button" class="language-switcher-btn" data-button-id="<%= uniqueId %>" aria-expanded="false" aria-haspopup="true">
            <span class="flex items-center">
                <span class="text-lg mr-2"><%= currentLangData.flag %></span>
                <span class="text-sm font-medium text-white"><%= currentLangData.name %></span>
                <svg class="ml-2 -mr-1 h-4 w-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </span>
        </button>
    </div>

    <!-- Menú desplegable -->
    <div class="hidden !bg-slate-800 rounded-lg shadow-[0_10px_40px_rgba(0,0,0,0.5)] border border-slate-600 overflow-hidden" data-menu-id="<%= uniqueId %>">
        <div class="py-1 flex flex-col !bg-slate-800" role="menu" aria-orientation="vertical">
            <% availableLanguages.forEach(lang => { %>
                <a href="/change-language?lng=<%= lang.code %>" class="flex items-center justify-between w-full px-4 py-3 !text-white hover:!bg-slate-700 transition-colors duration-200 border-b border-slate-700 last:border-b-0 <%= currentLang === lang.code ? '!bg-purple-600 !text-white font-semibold' : '!bg-slate-800' %> no-underline" role="menuitem">
                    <div class="flex items-center justify-between w-full">
                        <div class="flex items-center">
                            <span class="text-lg mr-3"><%= lang.flag %></span>
                            <span class="text-sm font-medium !text-white"><%= lang.name %></span>
                        </div>
                        <% if (currentLang === lang.code) { %>
                            <svg class="h-4 w-4 !text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                            </svg>
                        <% } %>
                    </div>
                </a>
            <% }); %>
        </div>
    </div>
</div>

<script>
(function() {
    // Setup language switcher functionality
    function setupLanguageSwitcher() {
        document.querySelectorAll('.language-switcher-btn').forEach(button => {
            // Remove old listeners by cloning
            const newButton = button.cloneNode(true);
            button.parentNode.replaceChild(newButton, button);
            
            newButton.addEventListener('click', function(e) {
                e.stopPropagation();
                const buttonId = this.getAttribute('data-button-id');
                const menu = document.querySelector(`[data-menu-id="${buttonId}"]`);
                
                if (!menu) return;
                
                // Close all other language menus
                document.querySelectorAll('.language-menu').forEach(m => {
                    if (m !== menu) {
                        m.classList.add('hidden');
                        // Remove any portal menus
                        const portalId = 'languageMenuPortal-' + m.getAttribute('data-menu-id');
                        const portal = document.getElementById(portalId);
                        if (portal) {
                            document.body.removeChild(portal);
                        }
                    }
                });
                
                if (menu.classList.contains('hidden')) {
                    // Open menu
                    const buttonRect = this.getBoundingClientRect();
                    const body = document.body;
                    const menuClone = menu.cloneNode(true);
                    const portalId = 'languageMenuPortal-' + buttonId;
                    menuClone.id = portalId;
                    menuClone.classList.remove('hidden');
                    
                    // Position the menu
                    menuClone.style.position = 'fixed';
                    menuClone.style.top = (buttonRect.bottom + 8) + 'px';
                    menuClone.style.zIndex = '9999999';
                    menuClone.style.width = '13rem';
                    menuClone.style.pointerEvents = 'auto';
                    
                    // Check if we have enough space on the right
                    const menuWidth = 208; // 13rem = 208px
                    const spaceOnRight = window.innerWidth - buttonRect.left;
                    
                    if (spaceOnRight >= menuWidth) {
                        // Position to the right of the button (align left edges)
                        menuClone.style.left = buttonRect.left + 'px';
                        menuClone.style.right = 'auto';
                    } else {
                        // Position to the left edge if not enough space
                        menuClone.style.right = (window.innerWidth - buttonRect.right) + 'px';
                        menuClone.style.left = 'auto';
                    }
                    
                    // Add to body
                    body.appendChild(menuClone);
                    menu.classList.add('hidden');
                    
                    // Close on item click
                    menuClone.addEventListener('click', function(e) {
                        if (e.target.closest('a[role="menuitem"]')) {
                            body.removeChild(menuClone);
                        }
                    });
                } else {
                    // Close menu
                    const portalId = 'languageMenuPortal-' + buttonId;
                    const portalMenu = document.getElementById(portalId);
                    if (portalMenu) {
                        document.body.removeChild(portalMenu);
                    }
                    menu.classList.add('hidden');
                }
            });
        });
    }
    
    // Close all language menus when clicking outside
    document.addEventListener('click', function(event) {
        if (!event.target.closest('.language-switcher-container')) {
            document.querySelectorAll('.language-menu').forEach(menu => {
                menu.classList.add('hidden');
            });
            document.querySelectorAll('[id^="languageMenuPortal-"]').forEach(portal => {
                document.body.removeChild(portal);
            });
        }
    });
    
    // Close on scroll
    window.addEventListener('scroll', function() {
        document.querySelectorAll('[id^="languageMenuPortal-"]').forEach(portal => {
            document.body.removeChild(portal);
        });
        document.querySelectorAll('.language-menu').forEach(menu => {
            menu.classList.add('hidden');
        });
    });
    
    // Initialize
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupLanguageSwitcher);
    } else {
        setupLanguageSwitcher();
    }
})();
</script>
