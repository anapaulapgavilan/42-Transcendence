<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">

<head>
    <meta charset="UTF-8" />
    <title><%= typeof t !== 'undefined' ? t('profile.editProfile') : 'Editar Perfil' %> - <%= typeof t !== 'undefined' ? t('common.gameTitle') : 'ft_transcendence' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">

    <link href="/public/styles.css" rel="stylesheet" />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-screen font-poppins bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 bg-fixed overflow-y-auto overflow-x-hidden">
    <!-- Fondo fijo con mesh -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-mesh-pattern bg-400 opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col">
        <header class="p-6 bg-white/5 backdrop-blur-lg border border-white/20">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <div class="flex items-center space-x-2">
                    <div
                        class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg">ft_transcendence</span>
                </div>

                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></span>
                    </a>

                    <a href="/profile" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></span>
                    </a>

                    <a href="/game" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></span>
                    </a>

                    <a href="/tournament" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></span>
                    </a>
                </div>

                <div class="flex items-center space-x-4">
                    <div class="hidden sm:block">
                        <%- include('components/languageSwitcher') %>
                    </div>
                    
                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium">
                                <%= usuario.alias %>
                            </p>
                            <p class="text-white/60 text-xs"><%= typeof t !== 'undefined' ? t('profile.editProfileDesc') : 'Editando perfil' %></p>
                        </div>
                        <div
                            class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">
                                <%= usuario.alias.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <button onclick="logout()" class="p-2 rounded-lg text-white/80 hover:text-white transition-all duration-300 hover:bg-red-500/20 hover:border hover:border-red-500/40 hover:scale-110 hover:shadow-[0_4px_15px_rgba(239,68,68,0.3)]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                            </path>
                        </svg>
                    </button>
                </div>

                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></a>
                    <a href="/profile" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></a>
                    <a href="/game" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></a>
                    <a href="/friends" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.friends') : 'Amigos' %></a>
                    <a href="/tournament" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1 flex items-center justify-center px-6 py-8">
            <div class="w-full max-w-2xl mx-auto">

                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp max-w-2xl mx-auto">
                    <div class="text-center mb-8">
                        <h1 class="text-3xl sm:text-4xl font-black mb-4">
                            <span class="bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron">
                                ⚙️ <%= typeof t !== 'undefined' ? t('profile.editProfile').toUpperCase() : 'EDITAR PERFIL' %>
                            </span>
                        </h1>
                        <p class="text-white/70 text-lg">
                            <%= typeof t !== 'undefined' ? t('editProfile.customizeExperience') : 'Personaliza tu experiencia de juego' %>
                        </p>
                    </div>

                    <% if (typeof error !=='undefined' ) { %>
                        <div class="flex items-center p-4 mb-6 rounded-xl border border-red-500/30 text-red-300 font-medium bg-[rgba(239,68,68,0.1)] animate-fadeInUp">
                            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= error %>
                        </div>
                        <% } %>

                            <form action="/editprofile" method="POST" enctype="multipart/form-data"
                                class="space-y-8">

                                <div class="space-y-6">
                                    <div class="flex items-center space-x-3 mb-4">
                                        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                                            </path>
                                        </svg>
                                        <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('editProfile.profilePhoto') : 'Foto de Perfil' %></h3>
                                    </div>

                                    <div class="space-y-6">
                                        <div class="flex items-center space-x-4">
                                            <div class="w-20 h-20 rounded-full flex items-center justify-center overflow-hidden bg-gradient-to-br from-purple-500 via-violet-600 to-purple-500" id="avatarPreview">
                                                <% if (usuario.avatar_url) { %>
                                                    <img src="<%= usuario.avatar_url %>"
                                                        class="w-full h-full object-cover rounded-full"
                                                        alt="Avatar actual">
                                                    <% } else { %>
                                                        <span class="text-white font-bold text-2xl">
                                                            <%= usuario.alias.charAt(0).toUpperCase() %>
                                                        </span>
                                                        <% } %>
                                            </div>
                                            <div class="flex-1">
                                                <p class="text-white/90 font-medium">
                                                    <%= usuario.alias %>
                                                </p>
                                                <p class="text-white/60 text-sm">
                                                    <% if (usuario.avatar_url) { %>
                                                        <%= typeof t !== 'undefined' ? t('editProfile.currentPhoto') : 'Foto actual' %>
                                                        <% } else { %>
                                                            <%= typeof t !== 'undefined' ? t('editProfile.noPhoto') : 'Sin foto (inicial)' %>
                                                            <% } %>
                                                </p>
                                            </div>
                                        </div>

                                        <label for="avatar" class="inline-flex items-center px-6 py-3 rounded-xl font-semibold transition-all duration-300 cursor-pointer bg-gradient-to-br from-indigo-600 to-purple-600 text-white scale-100 hover:scale-105 hover:shadow-[0_8px_25px_rgba(99,102,241,0.4)]">
                                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12">
                                                </path>
                                            </svg>
                                            <%= typeof t !== 'undefined' ? t('editProfile.changeImage') : 'Cambiar Imagen' %>
                                        </label>
                                        <input type="file" name="avatar" id="avatar" accept="image/*" class="hidden"
                                            onchange="previewAvatar(this); validateFileSize(this)" />
                                        <p class="text-white/60 text-sm"><%= typeof t !== 'undefined' ? t('editProfile.fileFormat') : 'PNG, JPG o GIF (máx. 5MB)' %></p>
                                        
                                        <div id="avatarError" class="text-red-400 text-sm mt-2 hidden">
                                            <%= typeof t !== 'undefined' ? t('editProfile.imageTooLarge') : 'La imagen es demasiado grande. Máximo 5MB.' %>
                                        </div>
                                    </div>
                                </div>

                                <div class="space-y-6">
                                    <div class="flex items-center space-x-3 mb-4">
                                        <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z">
                                            </path>
                                        </svg>
                                        <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('editProfile.basicInfo') : 'Información Básica' %></h3>
                                    </div>

                                    <div class="space-y-3 mb-6">
                                        <label for="alias" class="flex items-center text-sm font-medium text-white/90 mb-2 ml-1">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z">
                                                </path>
                                            </svg>
                                            <%= typeof t !== 'undefined' ? t('editProfile.alias') : 'Alias' %>
                                        </label>
                                        <input type="text" name="alias" id="alias" value="<%= usuario.alias %>"
                                            class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] focus-visible:outline-2 focus-visible:outline-purple-400/80 focus-visible:outline-offset-2" placeholder="<%= typeof t !== 'undefined' ? t('editProfile.aliasPlaceholder') : 'Tu nombre de usuario único' %>" required />
                                        <p class="text-white/60 text-xs mt-1"><%= typeof t !== 'undefined' ? t('editProfile.aliasHint') : 'Este será tu nombre visible en partidas y torneos' %></p>
                                    </div>
                                </div>

                                <div class="space-y-6">
                                    <div class="flex items-center space-x-3 mb-4">
                                        <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
                                        </svg>
                                        <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('profile.preferredLanguage') : 'Idioma Preferido' %></h3>
                                    </div>

                                    <div class="space-y-3 mb-6">
                                        <label for="preferred_language" class="flex items-center text-sm font-medium text-white/90 mb-2 ml-1">
                                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
                                            </svg>
                                            <%= typeof t !== 'undefined' ? t('profile.selectLanguage') : 'Selecciona tu idioma preferido' %>
                                        </label>
                                        <select name="preferred_language" id="preferred_language" class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] select-custom">
                                            <option value="es" <%= usuario.preferred_language === 'es' ? 'selected' : '' %>>
                                                🇪🇸 <%= typeof t !== 'undefined' ? t('profile.spanish') : 'Español' %>
                                            </option>
                                            <option value="en" <%= usuario.preferred_language === 'en' ? 'selected' : '' %>>
                                                🇺🇸 <%= typeof t !== 'undefined' ? t('profile.english') : 'English' %>
                                            </option>
                                            <option value="fr" <%= usuario.preferred_language === 'fr' ? 'selected' : '' %>>
                                                🇫🇷 <%= typeof t !== 'undefined' ? t('profile.french') : 'Français' %>
                                            </option>
                                            <option value="ro" <%= usuario.preferred_language === 'ro' ? 'selected' : '' %>>
                                                🇲🇩 <%= typeof t !== 'undefined' ? t('profile.romanian') : 'Română' %>
                                            </option>
                                        </select>
                                        <p class="text-white/60 text-xs mt-1"><%= typeof t !== 'undefined' ? t('profile.languageHint') : 'Este será tu idioma por defecto al iniciar sesión' %></p>
                                    </div>
                                </div>

                                <% if (usuario.auth_provider==='local' ) { %>
                                    <div class="space-y-6">
                                        <div class="flex items-center space-x-3 mb-4">
                                            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z">
                                                </path>
                                            </svg>
                                            <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('editProfile.security') : 'Seguridad' %></h3>
                                        </div>

                                        <div class="flex items-start space-x-3 p-4 rounded-xl border border-amber-500/30 mb-6 bg-[rgba(245,158,11,0.1)]">
                                            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.502 0L4.268 18.5c-.77.833.192 2.5 1.732 2.5z">
                                                </path>
                                            </svg>
                                            <div>
                                                <p class="text-amber-300 font-medium text-sm"><%= typeof t !== 'undefined' ? t('editProfile.passwordChange') : 'Cambio de Contraseña' %></p>
                                                <p class="text-amber-200/80 text-xs mt-1"><%= typeof t !== 'undefined' ? t('editProfile.passwordHint') : 'Deja los campos vacíos si no deseas cambiar tu contraseña' %></p>
                                            </div>
                                        </div>

                                        <div class="space-y-3 mb-6">
                                            <label for="current_password" class="flex items-center text-sm font-medium text-white/90 mb-2 ml-1">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z">
                                                    </path>
                                                </svg>
                                                <%= typeof t !== 'undefined' ? t('editProfile.currentPassword') : 'Contraseña Actual' %>
                                            </label>
                                            <input type="password" name="current_password" id="current_password"
                                                class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)]" placeholder="<%= typeof t !== 'undefined' ? t('editProfile.currentPasswordPlaceholder') : 'Ingresa tu contraseña actual' %>" />
                                        </div>

                                        <div class="space-y-3 mb-6">
                                            <label for="new_password" class="flex items-center text-sm font-medium text-white/90 mb-2 ml-1">
                                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z">
                                                    </path>
                                            </svg>
                                                <%= typeof t !== 'undefined' ? t('editProfile.newPassword') : 'Nueva Contraseña' %>
                                            </label>
                                            <input type="password" name="new_password" id="new_password"
                                                class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)]" placeholder="<%= typeof t !== 'undefined' ? t('editProfile.newPasswordPlaceholder') : 'Nueva contraseña (opcional)' %>" />
                                            <p class="text-white/60 text-xs mt-1"><%= typeof t !== 'undefined' ? t('editProfile.passwordRequirements') : 'Mínimo 8 caracteres, incluye números y letras' %></p>
                                        </div>
                                    </div>
                                    <% } %>

                                        <div class="flex flex-col sm:flex-row gap-4 justify-end pt-6 border-t border-white/20">
                                            <a href="/profile" class="px-8 py-4 text-white font-semibold rounded-xl bg-white/5 backdrop-blur-lg border border-white/20 hover:bg-white/10 transition-colors duration-200 flex items-center justify-center">
                                                <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                                                </svg>
                                                <span class="inline-block"><%= typeof t !== 'undefined' ? t('editProfile.cancel') : 'Cancelar' %></span>
                                            </a>
                                            <button type="submit" class="px-8 py-4 text-white font-semibold rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 backdrop-blur-lg border border-orange-600/30 hover:from-orange-600 hover:to-orange-700 transition-colors duration-200 flex items-center justify-center no-ripple" id="saveChangesButton">
                                                <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                                <span class="inline-block"><%= typeof t !== 'undefined' ? t('editProfile.saveChanges') : 'Guardar Cambios' %></span>
                                            </button>
                                        </div>
                            </form>
                            
                            <div class="space-y-6 mt-6">
                                <div class="flex items-center space-x-3 mb-4">
                                    <svg class="w-6 h-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                    </svg>
                                    <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('editProfile.twoFactorAuth') : 'Two-Factor Authentication' %></h3>
                                </div>

                                <div class="flex items-start space-x-3 p-4 rounded-xl border border-amber-500/30 bg-[rgba(245,158,11,0.1)]">
                                    <% if (usuario.two_fa_enabled) { %>
                                        <p class="text-green-400"><%= typeof t !== 'undefined' ? t('editProfile.twoFactorActive') : '2FA is currently' %> <strong><%= typeof t !== 'undefined' ? t('editProfile.active') : 'active' %></strong>.</p>
                                        
                                        <% if (usuario.two_fa_method === 'app') { %>
                                            <p class="text-white/70"><%= typeof t !== 'undefined' ? t('editProfile.method') : 'Method' %>: <strong><%= typeof t !== 'undefined' ? t('editProfile.authenticatorApp') : 'Authenticator App' %></strong></p>
                                            <a href="/setupEmail2fa" class="text-blue-400 hover:underline"><%= typeof t !== 'undefined' ? t('editProfile.switchToEmail') : 'Switch to 2FA via Email' %></a>
                                        <% } else if (usuario.two_fa_method === 'email') { %>
                                            <p class="text-white/70"><%= typeof t !== 'undefined' ? t('editProfile.method') : 'Method' %>: <strong><%= typeof t !== 'undefined' ? t('editProfile.email') : 'Email' %></strong></p>
                                            <a href="/setup2fa" class="text-blue-400 hover:underline"><%= typeof t !== 'undefined' ? t('editProfile.switchToApp') : 'Switch to 2FA via App' %></a>
                                        <% } %>

                                        <form action="/disable2fa" method="POST" class="mt-4">
                                            <button type="submit" class="text-red-400 hover:underline"><%= typeof t !== 'undefined' ? t('editProfile.disable2FA') : 'Disable 2FA' %></button>
                                        </form>

                                    <% } else { %>
                                        <p class="text-white/70"><%= typeof t !== 'undefined' ? t('editProfile.twoFactorDisabled') : '2FA is currently' %> <strong><%= typeof t !== 'undefined' ? t('editProfile.disabled') : 'disabled' %></strong>. <%= typeof t !== 'undefined' ? t('editProfile.selectMethod') : 'Select a method to enable it' %>:</p>
                                        <div class="space-y-2 mt-2">
                                            <div>
                                                <a href="/setup2fa" class="text-blue-400 hover:underline"><%= typeof t !== 'undefined' ? t('editProfile.enableApp') : 'Enable 2FA via App' %></a>
                                            </div>
                                            <div>
                                                <a href="/setupEmail2fa" class="text-blue-400 hover:underline"><%= typeof t !== 'undefined' ? t('editProfile.enableEmail') : 'Enable 2FA via Email' %></a>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        const MAX_FILE_SIZE_MB = 5; 
        const MAX_FILE_SIZE_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;

        function previewAvatar(input) {
            const avatarError = document.getElementById('avatarError');
            const saveButton = document.getElementById('saveChangesButton');

            avatarError.classList.add('hidden');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('avatarPreview');
                    preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover rounded-full" alt="Preview">`;
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                const preview = document.getElementById('avatarPreview');
                const alias = "<%= usuario.alias %>"; 
                const avatarUrl = "<%= usuario.avatar_url %>"; 
                
                if (avatarUrl && avatarUrl !== 'null') {
                    preview.innerHTML = `<img src="${avatarUrl}" class="w-full h-full object-cover rounded-full" alt="Avatar actual">`;
                } else {
                    preview.innerHTML = `<span class="text-white font-bold text-2xl">${alias.charAt(0).toUpperCase()}</span>`;
                }
            }
        }

        function validateFileSize(input) {
            const avatarError = document.getElementById('avatarError');
            const saveButton = document.getElementById('saveChangesButton');

            if (input.files && input.files[0]) {
                const fileSize = input.files[0].size; 

                if (fileSize > MAX_FILE_SIZE_BYTES) {
                    avatarError.classList.remove('hidden');
                    saveButton.disabled = true;
                    input.value = '';
                    
                    const preview = document.getElementById('avatarPreview');
                    const alias = "<%= usuario.alias %>";
                    const avatarUrl = "<%= usuario.avatar_url %>";
                    
                    if (avatarUrl && avatarUrl !== 'null') {
                        preview.innerHTML = `<img src="${avatarUrl}" class="w-full h-full object-cover rounded-full" alt="Avatar actual">`;
                    } else {
                        preview.innerHTML = `<span class="text-white font-bold text-2xl">${alias.charAt(0).toUpperCase()}</span>`;
                    }

                } else {
                    avatarError.classList.add('hidden'); 
                    saveButton.disabled = false;
                }
            } else {
                avatarError.classList.add('hidden');
                saveButton.disabled = false;
            }
        }

        function logout() {
            window.location.href = '/logout';
        }

        function toggleMobileMenu() {
            const mobileMenu = document.getElementById('mobileMenu');
            mobileMenu.classList.toggle('hidden');
        }
    </script>

    <script src="/public/js/landing.js"></script>
</body>
</html>
