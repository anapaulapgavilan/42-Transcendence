<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title><%= typeof t !== 'undefined' ? t('friends.title') : 'Amigos' %> - <%= typeof t !== 'undefined' ? t('common.gameTitle') : 'ft_transcendence' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- FAVICON -->
    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
    
    <!-- CSS compilado por Tailwind -->
    <link href="/public/styles.css" rel="stylesheet" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen font-poppins bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 bg-fixed overflow-y-auto overflow-x-hidden">
    <!-- Fondo fijo con mesh -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-mesh-pattern bg-400 opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <!-- Contenido principal -->
    <div class="relative z-10 min-h-screen flex flex-col">
        <!-- Header/Navbar -->
        <header class="p-6 bg-white/5 backdrop-blur-lg border border-white/20">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <!-- Logo -->
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg">ft_transcendence</span>
                </div>

                <!-- Navegación Principal -->
                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('common.home') : 'Home' %></span>
                    </a>
                    
                    <a href="/profile" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('common.profile') : 'Perfil' %></span>
                    </a>
                    
                    <a href="/game" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('common.game') : 'Game' %></span>
                    </a>
                    
                    <a href="/friends" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('common.friends') : 'Amigos' %></span>
                    </a>
                    
                    <a href="/tournament" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('common.tournaments') : 'Torneos' %></span>
                    </a>
                </div>

                <!-- Usuario y Logout -->
                <div class="flex items-center space-x-4">
                    <!-- Language Switcher -->
                    <div class="hidden sm:block">
                        <%- include('components/languageSwitcher') %>
                    </div>
                    
                    <!-- Info del usuario -->
                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium"><%= typeof t !== 'undefined' ? t('common.profile') : 'Usuario' %></p>
                            <p class="text-white/60 text-xs"><%= typeof t !== 'undefined' ? t('common.level') : 'Nivel' %> <%= (Math.floor((user.wins + user.looses) / 5) + 1) %></p> 
                        </div>
                        <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">U</span>
                        </div>
                    </div>

                    <!-- Botón Logout -->
                    <button onclick="logout()" class="p-2 rounded-lg text-white/80 hover:text-white transition-all duration-300 hover:bg-red-500/20 hover:border hover:border-red-500/40 hover:scale-110 hover:shadow-[0_4px_15px_rgba(239,68,68,0.3)]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                    </button>
                </div>

                <!-- Menú Móvil -->
                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <!-- Menú móvil desplegable -->
            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10"><%= typeof t !== 'undefined' ? t('common.home') : 'Home' %></a>
                    <a href="/profile" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10"><%= typeof t !== 'undefined' ? t('common.profile') : 'Perfil' %></a>
                    <a href="/game" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10"><%= typeof t !== 'undefined' ? t('common.game') : 'Game' %></a>
                    <a href="/friends" class="block px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300"><%= typeof t !== 'undefined' ? t('common.friends') : 'Amigos' %></a>
                    <a href="/tournament" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10"><%= typeof t !== 'undefined' ? t('common.tournaments') : 'Torneos' %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Contenido principal -->
        <main class="flex-1 flex items-center justify-center px-6 py-12">
            <div class="w-full max-w-6xl mx-auto">
                <!-- Container principal con glass effect -->
                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp">
                    
                    <!-- Header de la página -->
                    <div class="text-center mb-12">
                        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight mb-4">
                            <span class="block bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron tracking-tight">
                                🤝 <%= typeof t !== 'undefined' ? t('friends.title') : 'AMIGOS' %>
                            </span>
                        </h1>
                        <p class="text-white/70 text-lg mt-4">
                            <%= typeof t !== 'undefined' ? t('friends.subtitle') : 'Conecta, juega y compite con tus amigos' %>
                        </p>
                    </div>

                    <!-- Buscador de amigos -->
                    <div class="mb-8 p-6 rounded-2xl bg-white/5 border border-white/10">
                        <h2 class="text-2xl font-bold text-white mb-4 flex items-center">
                            <svg class="w-6 h-6 mr-3 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('friends.searchUsers') : 'Buscar Usuarios' %>
                        </h2>
                        
                        <form action="/friends" method="POST" class="space-y-4">
                            <div class="flex flex-col sm:flex-row gap-3">
                                <input 
                                    type="text" 
                                    name="searchQuery" 
                                    placeholder="<%= typeof t !== 'undefined' ? t('friends.searchPlaceholder') : 'Buscar por alias o email...' %>" 
                                    value="<%= searchQuery || '' %>"
                                    class="flex-1 w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] focus-visible:outline-2 focus-visible:outline-purple-400/80 focus-visible:outline-offset-2"
                                    required
                                />
                                
                                <button type="submit" class="group relative px-8 py-4 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 overflow-hidden bg-gradient-to-r from-orange-500 to-orange-600 hover:-translate-y-1 hover:shadow-[0_25px_50px_-12px_rgba(249,115,22,0.25)] animate-glow whitespace-nowrap">
                                    <span class="relative z-10 flex items-center justify-center">
                                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                        </svg>
                                        <%= typeof t !== 'undefined' ? t('friends.searchButton') : 'Buscar' %>
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Resultados de búsqueda -->
                    <% if (typeof searchResults !== 'undefined') { %>
                    <div class="mb-8 p-6 rounded-2xl bg-white/5 border border-white/10">
                        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
                            <svg class="w-6 h-6 mr-3 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('friends.searchResults') : 'Resultados para' %>: <%= searchQuery %>
                        </h2>

                        <% if (searchResults.length === 0) { %>
                            <div class="text-center py-12">
                                <svg class="w-16 h-16 text-white/30 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p class="text-white/60"><%= typeof t !== 'undefined' ? t('friends.noUsersFound') : 'No se encontraron usuarios con' %> :<%= searchQuery %></p>
                            </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <% searchResults.forEach(user => { %>
                                <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 backdrop-blur-lg border border-white/20 hover:bg-white/8 hover:border-white/30 transition-all duration-300">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-12 h-12 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center">
                                            <span class="text-white font-bold">
                                                <%= user.alias.charAt(0).toUpperCase() %>
                                            </span>
                                        </div>
                                        <div>
                                            <h3 class="text-white font-semibold"><%= user.alias %></h3>
                                            <p class="text-white/60 text-sm"><%= user.mail %></p>
                                        </div>
                                    </div>
                                    <form action="/friends" method="POST">
                                        <input type="hidden" name="userIdToInvite" value="<%= user.id %>" />
                                        <input type="hidden" name="action" value="invite" />
                                        <button type="submit" class="no-ripple flex items-center space-x-1 px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-300">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                            </svg>
                                            <span><%= typeof t !== 'undefined' ? t('friends.inviteFriend') : 'Invitar' %></span>
                                        </button>
                                    </form>
                                </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                    <% } %>

                    <!-- Invitaciones pendientes -->
                    <div class="mb-8 p-6 rounded-2xl bg-white/5 border border-white/10">
                        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
                            <svg class="w-6 h-6 mr-3 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('friends.pendingInvites') : 'Invitaciones Pendientes' %>
                            <% if (pendingInvites.length > 0) { %>
                                <span class="ml-3 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-500/20 text-yellow-400 border border-yellow-500/30"><%= pendingInvites.length %></span>
                            <% } %>
                        </h2>

                        <% if (pendingInvites.length === 0) { %>
                            <div class="text-center py-8">
                                <svg class="w-12 h-12 text-white/30 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                </svg>
                                <p class="text-white/60"><%= typeof t !== 'undefined' ? t('friends.noPendingInvites') : 'No tienes invitaciones pendientes' %></p>
                            </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <% pendingInvites.forEach(invite => { %>
                                <div class="p-4 rounded-xl bg-yellow-500/5 backdrop-blur-lg border border-yellow-500/30 hover:bg-yellow-500/10 transition-all duration-300">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-12 h-12 bg-gradient-to-r from-yellow-500 to-orange-500 rounded-full flex items-center justify-center">
                                                <span class="text-white font-bold">
                                                    <%= invite.alias.charAt(0).toUpperCase() %>
                                                </span>
                                            </div>
                                            <div>
                                                <h3 class="text-white font-semibold"><%= invite.alias %></h3>
                                                <p class="text-white/60 text-sm"><%= invite.mail %></p>
                                                <span class="text-yellow-400 text-xs"><%= typeof t !== 'undefined' ? t('friends.invitationSent') : 'Te ha enviado una invitación' %></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex gap-2">
                                        <form action="/friends" method="POST" class="flex-1">
                                            <input type="hidden" name="inviteId" value="<%= invite.id_user1 %>" />
                                            <input type="hidden" name="action" value="accept" />
                                            <button type="submit" class="no-ripple w-full flex items-center justify-center space-x-1 px-4 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-colors duration-300">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                                <span><%= typeof t !== 'undefined' ? t('friends.acceptInvite') : 'Aceptar' %></span>
                                            </button>
                                        </form>
                                        <form action="/friends" method="POST">
                                            <input type="hidden" name="inviteId" value="<%= invite.id_user1 %>" />
                                            <input type="hidden" name="action" value="reject" />
                                            <button type="submit" class="no-ripple flex items-center justify-center space-x-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg transition-colors duration-300">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                </svg>
                                                <span><%= typeof t !== 'undefined' ? t('friends.rejectInvite') : 'Rechazar' %></span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                    <!-- Lista de amigos -->
                    <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
                        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
                            <svg class="w-6 h-6 mr-3 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('friends.myFriends') : 'Mis Amigos' %>
                            <% if (friends.length > 0) { %>
                                <span class="ml-3 inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400 border border-blue-500/30"><%= friends.length %></span>
                            <% } %>
                        </h2>

                        <% if (friends.length === 0) { %>
                            <div class="text-center py-12">
                                <svg class="w-16 h-16 text-white/30 mx-auto mb-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path>
                                </svg>
                                <p class="text-white/60 mb-4"><%= typeof t !== 'undefined' ? t('friends.noFriendsYet') : 'Aún no tienes amigos' %></p>
                                <p class="text-white/40 text-sm"><%= typeof t !== 'undefined' ? t('friends.findUsersHint') : '¡Busca usuarios y envía invitaciones para empezar a jugar!' %></p>
                            </div>
                        <% } else { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                <% friends.forEach(friend => { %>
                                <div class="p-4 rounded-xl bg-white/5 backdrop-blur-lg border border-white/20 hover:bg-white/8 hover:border-white/30 transition-all duration-300">
                                    <div class="flex items-start justify-between mb-3">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center">
                                                <span class="text-white font-bold">
                                                    <%= friend.alias.charAt(0).toUpperCase() %>
                                                </span>
                                            </div>
                                            <div>
                                                <h3 class="text-white font-semibold"><%= friend.alias %></h3>
                                                <p class="text-white/60 text-sm"><%= friend.mail %></p>
                                                <div class="flex items-center space-x-2 mt-1">
                                                    <% if (friend.is_online) { %>
                                                        <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                                                        <span class="text-green-400 text-xs"><%= typeof t !== 'undefined' ? t('friends.onlineStatus') : 'En línea' %></span>
                                                    <% } else { %>
                                                        <div class="w-2 h-2 bg-gray-500 rounded-full"></div>
                                                        <span class="text-gray-400 text-xs"><%= typeof t !== 'undefined' ? t('friends.offlineStatus') : 'Fuera de línea' %></span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <form action="/friends" method="POST" onsubmit="return confirmRemoveFriend();">
                                        <input type="hidden" name="friendId" value="<%= friend.id %>" />
                                        <input type="hidden" name="action" value="remove" />
                                        <button type="submit" class="no-ripple w-full flex items-center justify-center space-x-1 px-3 py-2 bg-red-500/20 hover:bg-red-500/30 text-red-400 font-medium rounded-lg border border-red-500/30 transition-colors duration-300" title="<%= typeof t !== 'undefined' ? t('friends.removeFriend') : 'Eliminar' %>">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            <span><%= typeof t !== 'undefined' ? t('friends.removeFriend') : 'Eliminar' %></span>
                                        </button>
                                    </form>
                                </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                </div>
            </div>
        </main>
    </div>
    
    <!-- JavaScript para efectos interactivos -->
    <script src="/public/js/landing.js"></script>
    
    <script>
    function confirmRemoveFriend() {
        return confirm('¿Estás seguro de eliminar este amigo?');
    }
    </script>
</body>
</html>
