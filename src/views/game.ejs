<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %> - <%= typeof t !== 'undefined' ? t('common.gameTitle') : 'ft_transcendence' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="./public/favicon.svg">
    <link href="/public/styles.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen font-poppins bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 bg-fixed overflow-y-auto overflow-x-hidden">
    <!-- Fondo fijo con mesh -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-mesh-pattern bg-400 opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <!-- Contenido principal -->
    <div class="relative z-10 min-h-screen flex flex-col">
        <!-- Header/Navbar -->
        <header class="p-6 bg-white/5 backdrop-blur-lg border border-white/20">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <!-- Logo -->
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg">ft_transcendence</span>
                </div>

                <!-- Navegación Principal -->
                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 scale-100 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></span>
                    </a>
                    
                    <a href="/profile" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 scale-100 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></span>
                    </a>
                    
                    <a href="/game" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></span>
                    </a>
                    
                    <a href="/tournament" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 scale-100 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></span>
                    </a>
                </div>

                <!-- Usuario y Logout -->
                <div class="flex items-center space-x-4">
                    <!-- Language Switcher -->
                    <div class="hidden sm:block">
                        <%- include('components/languageSwitcher') %>
                    </div>
                    
                    <!-- Info del usuario -->
                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium"><%= user.alias %></p>
                            <p class="text-white/60 text-xs"><%= typeof t !== 'undefined' ? t('profile.level') : 'Nivel' %> <%= (Math.floor((user.wins + user.looses) / 5) + 1) %></p>
                        </div>
                        <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">
                                <%= user.alias.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <!-- Botón Logout -->
                    <button onclick="logout()" class="p-2 rounded-lg text-white/80 hover:text-white hover:bg-red-500/20 border border-transparent hover:border-red-500/40 transition-all duration-300 scale-100 hover:scale-110 hover:shadow-[0_4px_15px_rgba(239,68,68,0.3)]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                    </button>
                </div>

                <!-- Menú Móvil -->
                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <!-- Menú móvil desplegable -->
            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></a>
                    <a href="/profile" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></a>
                    <a href="/game" class="mobile-nav-item active"><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></a>
                    <a href="/tournament" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Contenido principal -->
        <main class="flex-1 flex items-center justify-center px-6 py-12">
            <div class="w-full max-w-4xl mx-auto">
                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/8 shadow-glass transition-all duration-300 relative animate-fadeInUp">
                    <!-- Badge de New Game -->
                    <div class="inline-block px-4 py-2 rounded-full text-orange-300 text-sm font-medium bg-white/5 backdrop-blur-lg border border-white/10 shadow-neon mb-6 animate-pulse">
                            <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('game.newGame') : 'Nueva Partida' %>
                        </div>
                        
                    <!-- Título con efecto gradient -->
                    <div class="text-center mb-12">
                        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight mb-4">
                            <span class="block bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron tracking-tight">
                                <%= typeof t !== 'undefined' ? t('game.timeToPlay') : '¡HORA DE JUGAR' %>
                            </span>
                            <span class="block text-orange-400 font-orbitron tracking-tight">
                                <%= user.alias.toUpperCase() %>!
                            </span>
                        </h1>
                        <p class="text-white/70 text-lg mt-4">
                            <%= typeof t !== 'undefined' ? t('game.configureGame') : 'Configura tu partida y prepárate para la batalla' %>
                        </p>
                    </div>

                    <!-- Formulario -->
                    <form action="/game" method="POST" class="space-y-6">
                        <!-- Configuración de IA -->
                        <div class="space-y-6">
                            <div class="flex items-center space-x-3 mb-4">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-purple-500 to-violet-600 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('game.opponentConfig') : 'Configuración de Oponente' %></h3>
                                    <p class="text-white/60 text-sm"><%= typeof t !== 'undefined' ? t('game.chooseOpponent') : 'Elige contra quién quieres jugar' %></p>
                                </div>
                            </div>
                            
                            <label class="flex items-center p-5 rounded-xl bg-white/5 border border-white/10 cursor-pointer hover:bg-white/10 hover:border-purple-400/40 transition-all duration-300">
                                <input type="checkbox" name="IA" value="true" class="w-5 h-5 rounded border-2 border-white/30 bg-white/10 text-purple-600 focus:ring-2 focus:ring-purple-400/50 focus:ring-offset-0 transition-all mr-3">
                                <span class="text-white font-medium"><%= typeof t !== 'undefined' ? t('game.enableAI') : 'Activar IA' %></span>
                                </label>
                            <p class="text-white/50 text-sm ml-1"><%= typeof t !== 'undefined' ? t('game.aiHint') : 'Cuando esté activado, jugarás contra la inteligencia artificial' %></p>
                        </div>

                        <!-- Nombre del oponente -->
                        <div class="space-y-6" id="nameSection">
                            <div class="flex items-center space-x-3 mb-4">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-blue-500 to-cyan-600 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('game.opponentName') : 'Nombre del Oponente' %></h3>
                                    <p class="text-white/60 text-sm"><%= typeof t !== 'undefined' ? t('game.enterOpponentName') : 'Introduce el nombre del jugador rival' %></p>
                                </div>
                            </div>
                            
                            <div class="space-y-3">
                                    <input 
                                        type="text" 
                                        id="name" 
                                        name="name" 
                                        placeholder="<%= typeof t !== 'undefined' ? t('game.usernamePlaceholder') : 'Introduce un nombre de usuario' %>"
                                    class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] focus-visible:outline-2 focus-visible:outline-purple-400/80 focus-visible:outline-offset-2"
                                        required
                                    >
                                <p class="text-white/60 text-xs mt-1"><%= typeof t !== 'undefined' ? t('game.nameHint') : 'Este será el nombre que aparezca durante la partida' %></p>
                            </div>
                        </div>

                        <!-- Dificultad -->
                        <div class="space-y-6" id="difficultySection" style="display: none;">
                            <div class="flex items-center space-x-3 mb-4">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-red-500 to-orange-600 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-white"><%= typeof t !== 'undefined' ? t('game.difficulty') : 'Dificultad de la IA' %></h3>
                                    <p class="text-white/60 text-sm"><%= typeof t !== 'undefined' ? t('game.chooseDifficulty') : 'Elige el nivel de la IA' %></p>
                                </div>
                            </div>

                            <select name="difficulty" class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] cursor-pointer appearance-none bg-[url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 fill=%22none%22 viewBox=%220 0 24 24%22 stroke=%22white%22%3E%3Cpath stroke-linecap=%22round%22 stroke-linejoin=%22round%22 stroke-width=%222%22 d=%22M19 9l-7 7-7-7%22%3E%3C/path%3E%3C/svg%3E')] bg-no-repeat bg-[right_12px_center] bg-[length:20px] pr-10">
                                <option value="easy" class="bg-slate-900 text-white p-2.5 font-medium"><%= typeof t !== 'undefined' ? t('game.easy') : 'Fácil' %></option>
                                <option value="medium" selected class="bg-slate-900 text-white p-2.5 font-medium"><%= typeof t !== 'undefined' ? t('game.medium') : 'Medio' %></option>
                                <option value="hard" class="bg-slate-900 text-white p-2.5 font-medium"><%= typeof t !== 'undefined' ? t('game.hard') : 'Difícil' %></option>
                                </select>
                        </div>

                        <!-- Botones de acción -->
                        <div class="flex flex-col sm:flex-row gap-4 pt-6">
                            <button type="submit" class="relative flex-1 px-8 py-4 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-red-600 scale-100 hover:scale-105 hover:shadow-[0_25px_50px_-12px_rgba(249,115,22,0.25)] animate-glow">
                                <span class="relative z-10 flex items-center justify-center">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.26a1 1 0 001.555.832l3.197-2.132c.563-.375.563-1.155 0-1.53z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <%= typeof t !== 'undefined' ? t('game.createGame') : 'Crear Partida' %>
                                </span>
                            </button>
                            
                            <a href="/home" class="relative flex-1 px-8 py-4 text-white font-semibold rounded-xl transition-all duration-300 bg-white/10 backdrop-blur-lg border border-white/20 hover:bg-white/15 hover:border-white/40 scale-100 hover:scale-105 shadow-neon hover:shadow-neon-hover flex items-center justify-center">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                                </svg>
                                <%= typeof t !== 'undefined' ? t('game.backToHome') : 'Volver al Home' %>
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <script src="/public/js/landing.js"></script>
    <script>
       document.addEventListener('DOMContentLoaded', function () {
            const aiCheckbox = document.querySelector('input[name="IA"]');
            const nameSection = document.getElementById('nameSection');
            const difficultySection = document.getElementById('difficultySection');
            const nameInput = document.getElementById('name');

            function toggleSections() {
                if (aiCheckbox.checked) {
                    nameSection.style.display = 'none';
                    nameInput.required = false;
                    difficultySection.style.display = 'block';
                } else {
                    nameSection.style.display = 'block';
                    nameInput.required = true;
                    difficultySection.style.display = 'none';
                }
            }

            aiCheckbox.addEventListener('change', toggleSections);
            toggleSections();
        });
    </script>
</body>
</html>
