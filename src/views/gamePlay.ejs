<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Partida en curso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #111;
            color: white;
            text-align: center;
            margin: 0;
            padding: 0;
        }
        canvas {
            display: block;
            margin: 50px auto;
            background: #000;
            border: 2px solid #fff;
        }
    </style>
</head>
<body>

<!-- Inyectar datos iniciales para el JS -->
<script>
    window.GAME_DATA = {
        userName: "<%= nombreUsuario1 %>",
        opponentName: "<%= nombreUsuario2 %>",
        score1: <%= puntuacion1 %>,
        score2: <%= puntuacion2 %>,
        isAI: <%= IA ? 'true' : 'false' %>,
        humanPlayer: '<%= humanPlayer %>',
        isPlayer1AI: <%= typeof isPlayer1AI !== 'undefined' ? isPlayer1AI : 'false' %>,
        isPlayer2AI: <%= typeof isPlayer2AI !== 'undefined' ? isPlayer2AI : 'false' %>,
        match_id: "<%= typeof match_id !== 'undefined' && match_id !== null ? match_id : '' %>",
        difficulty: "<%= typeof difficulty !== 'undefined' ? difficulty : 'medium' %>"
    };
</script>

<!-- Canvas donde se dibuja el juego -->
<canvas id="pong" width="800" height="500"></canvas>

<!-- Cargar la lógica del juego -->
<script src="/public/js/gamePlay.js"></script>

</body>
</html>
