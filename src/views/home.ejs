<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title>Home - ft_transcendence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- FAVICON -->
    <link rel="icon" type="image/svg+xml" href="./public/favicon.svg">
    
    <!-- CSS compilado por Tailwind -->
    <link href="/public/styles.css" rel="stylesheet" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen font-poppins bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 bg-fixed overflow-y-auto overflow-x-hidden">
    <!-- Fondo con gradiente y mesh fijo -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-mesh-pattern bg-400 opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <!-- Contenido principal -->
    <div class="relative z-10 min-h-screen flex flex-col">
        <!-- Header/Navbar -->
        <header class="p-6 bg-white/5 backdrop-blur-lg border border-white/20">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <!-- Logo -->
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg"><%= t('common.ftTranscendence') %></span>
                </div>

                <!-- Navegación Principal -->
                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        <span><%= t('common.home') %></span>
                    </a>
                    
                    <a href="/profile" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= t('common.profile') %></span>
                    </a>
                    
                    <a href="/game" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= t('common.game') %></span>
                    </a>
                    
                    <a href="/tournament" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                        </svg>
                        <span><%= t('common.tournaments') %></span>
                    </a>
                </div>

                <!-- Usuario y Logout -->
                <div class="flex items-center space-x-4">
                    <!-- Language Switcher -->
                    <div class="hidden sm:block">
                        <%- include('components/languageSwitcher') %>
                    </div>
                    
                    <!-- Info del usuario -->
                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium"><%= user.alias %></p>
                            <p class="text-white/60 text-xs"><%= t('common.level') %> <%= user.level || 1 %></p>
                        </div>
                        <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">
                                <%= user.alias.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <!-- Botón Logout -->
                    <button onclick="logout()" class="p-2 rounded-lg text-white/80 hover:text-white transition-all duration-300 hover:bg-red-500/20 hover:border hover:border-red-500/40 hover:scale-110 hover:shadow-[0_4px_15px_rgba(239,68,68,0.3)]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                    </button>
                </div>

                <!-- Menú Móvil -->
                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <!-- Menú móvil desplegable -->
            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="block px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300"><%= t('common.home') %></a>
                    <a href="/profile" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= t('common.profile') %></a>
                    <a href="/game" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= t('common.game') %></a>
                    <a href="/tournament" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= t('common.tournaments') %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Contenido principal -->
        <main class="flex-1 flex items-center justify-center px-6 py-12">
            <div class="w-full max-w-6xl mx-auto">
                <!-- Container principal con glass effect -->
                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp max-w-6xl mx-auto">
                    <!-- Header de bienvenida -->
                    <div class="text-center mb-12">
                        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight">
                            <span class="block bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron tracking-tight">
                                <%= t('home.welcome') %>
                            </span>
                            <span class="block text-orange-400 font-orbitron tracking-tight">
                                <%= user.alias.toUpperCase() %>!
                            </span>
                        </h1>
                        <p class="text-white/70 text-lg mt-4">
                            <%= t('home.readyToDominate') %>
                        </p>
                    </div>

                    <!-- Grid de acciones principales -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                        <!-- Jugar Ahora -->
                        <a href="/game" class="group block p-6 rounded-2xl backdrop-blur-lg border border-white/20 transition-all duration-300 text-center bg-white/5 scale-100 hover:bg-white/12 hover:border-white/40 hover:scale-105 hover:shadow-[0_8px_25px_rgba(0,0,0,0.3),0_0_20px_rgba(168,85,247,0.4)] animate-fadeInUp">
                            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white mx-auto mb-4 bg-gradient-to-r from-green-500 to-emerald-600 transition-transform duration-200 ease-out group-hover:scale-110">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2"><%= t('common.playNow') %></h3>
                            <p class="text-white/60 text-sm"><%= t('common.quickMatch') %></p>
                        </a>

                        <!-- Torneos -->
                        <a href="/tournament" class="group block p-6 rounded-2xl backdrop-blur-lg border border-white/20 transition-all duration-300 text-center bg-white/5 scale-100 hover:bg-white/12 hover:border-white/40 hover:scale-105 hover:shadow-[0_8px_25px_rgba(0,0,0,0.3),0_0_20px_rgba(168,85,247,0.4)] animate-fadeInUp [animation-delay:0.1s]">
                            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white mx-auto mb-4 bg-gradient-to-r from-purple-500 to-violet-600 transition-transform duration-200 ease-out group-hover:scale-110">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2"><%= t('common.tournaments') %></h3>
                            <p class="text-white/60 text-sm"><%= t('common.competeForGlory') %></p>
                        </a>

                        <!-- Mi Perfil -->
                        <a href="/profile" class="group block p-6 rounded-2xl backdrop-blur-lg border border-white/20 transition-all duration-300 text-center bg-white/5 scale-100 hover:bg-white/12 hover:border-white/40 hover:scale-105 hover:shadow-[0_8px_25px_rgba(0,0,0,0.3),0_0_20px_rgba(168,85,247,0.4)] animate-fadeInUp [animation-delay:0.2s]">
                            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white mx-auto mb-4 bg-gradient-to-r from-blue-500 to-cyan-600 transition-transform duration-200 ease-out group-hover:scale-110">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2"><%= t('common.myProfile') %></h3>
                            <p class="text-white/60 text-sm"><%= t('common.viewStats') %></p>
                        </a>

                        <!-- Editar Perfil -->
                        <a href="/editprofile" class="group block p-6 rounded-2xl backdrop-blur-lg border border-white/20 transition-all duration-300 text-center bg-white/5 scale-100 hover:bg-white/12 hover:border-white/40 hover:scale-105 hover:shadow-[0_8px_25px_rgba(0,0,0,0.3),0_0_20px_rgba(168,85,247,0.4)] animate-fadeInUp [animation-delay:0.3s]">
                            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-white mx-auto mb-4 bg-gradient-to-r from-orange-500 to-red-600 transition-transform duration-200 ease-out group-hover:scale-110">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-white mb-2"><%= t('common.configure') %></h3>
                            <p class="text-white/60 text-sm"><%= t('common.editProfileDesc') %></p>
                        </a>
                    </div>

                    <!-- Stats del usuario -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div class="text-center rounded-xl p-6 bg-white/5 backdrop-blur-lg border border-white/20 shadow-neon transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] scale-100 hover:bg-white/[0.08] hover:border-white/30 hover:scale-[1.03] hover:shadow-[0_0_25px_rgba(168,85,247,0.4),inset_0_0_20px_rgba(168,85,247,0.15)] animate-fadeInUp [animation-delay:0.2s]">
                            <div class="text-3xl font-bold bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent mb-2"><%= user.wins || 0 %></div>
                            <div class="text-white/60 text-sm"><%= t('common.wins') %></div>
                        </div>
                        <div class="text-center rounded-xl p-6 bg-white/5 backdrop-blur-lg border border-white/20 shadow-neon transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] scale-100 hover:bg-white/[0.08] hover:border-white/30 hover:scale-[1.03] hover:shadow-[0_0_25px_rgba(168,85,247,0.4),inset_0_0_20px_rgba(168,85,247,0.15)] animate-fadeInUp [animation-delay:0.2s]">
                            <div class="text-3xl font-bold bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent mb-2"><%= user.losses || 0 %></div>
                            <div class="text-white/60 text-sm"><%= t('common.losses') %></div>
                        </div>
                        <div class="text-center rounded-xl p-6 bg-white/5 backdrop-blur-lg border border-white/20 shadow-neon transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] scale-100 hover:bg-white/[0.08] hover:border-white/30 hover:scale-[1.03] hover:shadow-[0_0_25px_rgba(168,85,247,0.4),inset_0_0_20px_rgba(168,85,247,0.15)] animate-fadeInUp [animation-delay:0.2s]">
                            <div class="text-3xl font-bold bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent mb-2"><%= user.level || 1 %></div>
                            <div class="text-white/60 text-sm"><%= t('common.level') %></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>


    <!-- JavaScript para efectos interactivos -->
    <script src="/public/js/landing.js"></script>
</body>
</html>
