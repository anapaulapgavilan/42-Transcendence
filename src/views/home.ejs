<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title>Home - ft_transcendence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- FAVICON -->
    <link rel="icon" type="image/svg+xml" href="./public/favicon.svg">
    
    <!-- CSS compilado por Tailwind -->
    <link href="/public/styles.css" rel="stylesheet" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="home-page min-h-full font-poppins">
    <!-- Fondo con gradiente y mesh (mismo que otras páginas) -->
   <div class="absolute inset-0 z-0 min-h-screen">
        <!-- Gradiente base -->
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900"></div>
        
        <!-- Gradiente vibrante -->
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-pink-500/30 to-blue-600/20 bg-mesh opacity-80"></div>
        
        <!-- Overlay oscuro para mejor contraste -->
        <div class="absolute inset-0 bg-black/20"></div>
        
        <!-- Partículas flotantes -->
        <div class="absolute inset-0">
            <div class="floating-particle particle-1"></div>
            <div class="floating-particle particle-2"></div>
            <div class="floating-particle particle-3"></div>
            <div class="floating-particle particle-4"></div>
        </div>
    </div>

    <!-- Contenido principal -->
   <div class="relative z-10 min-h-screen flex flex-col">
        <!-- Header/Navbar -->
        <header class="p-6 glass-effect">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <!-- Logo -->
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg"><%= t('common.ftTranscendence') %></span>
                </div>

                <!-- Navegación Principal -->
                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="nav-menu-item active">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                        <span><%= t('common.home') %></span>
                    </a>
                    
                    <a href="/profile" class="nav-menu-item">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= t('common.profile') %></span>
                    </a>
                    
                    <a href="/game" class="nav-menu-item">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= t('common.game') %></span>
                    </a>
                    
                    <a href="/tournament" class="nav-menu-item">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                        </svg>
                        <span><%= t('common.tournaments') %></span>
                    </a>
                </div>

                <!-- Usuario y Logout -->
                <div class="flex items-center space-x-4">
                    <!-- Language Switcher -->
                    <div class="hidden sm:block">
                        <%- include('components/languageSwitcher') %>
                    </div>
                    
                    <!-- Info del usuario -->
                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium"><%= user.alias %></p>
                            <p class="text-white/60 text-xs"><%= t('common.level') %> <%= user.level || 1 %></p>
                        </div>
                        <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">
                                <%= user.alias.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <!-- Botón Logout -->
                    <button onclick="logout()" class="logout-btn">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                    </button>
                </div>

                <!-- Menú Móvil -->
                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <!-- Menú móvil desplegable -->
            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="mobile-nav-item active"><%= t('common.home') %></a>
                    <a href="/profile" class="mobile-nav-item"><%= t('common.profile') %></a>
                    <a href="/game" class="mobile-nav-item"><%= t('common.game') %></a>
                    <a href="/tournament" class="mobile-nav-item"><%= t('common.tournaments') %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Contenido principal -->
        <main class="flex-1 flex items-center justify-center px-6 py-12">
            <div class="w-full max-w-6xl mx-auto">
                <!-- Container principal con glass effect -->
                <div class="home-container glass-effect">
                    <!-- Header de bienvenida -->
                    <div class="text-center mb-12">
                        <h1 class="welcome-title">
                            <span class="block text-gradient font-orbitron tracking-tight">
                                <%= t('home.welcome') %>
                            </span>
                            <span class="block text-gradient font-orbitron tracking-tight text-orange-400">
                                <%= user.alias.toUpperCase() %>!
                            </span>
                        </h1>
                        <p class="text-white/70 text-lg mt-4">
                            <%= t('home.readyToDominate') %>
                        </p>
                    </div>

                    <!-- Grid de acciones principales -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                        <!-- Jugar Ahora -->
                        <a href="/game" class="action-card group">
                            <div class="action-card-icon bg-gradient-to-r from-green-500 to-emerald-600">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <h3 class="action-card-title"><%= t('common.playNow') %></h3>
                            <p class="action-card-desc"><%= t('common.quickMatch') %></p>
                        </a>

                        <!-- Torneos -->
                        <a href="/tournament" class="action-card group">
                            <div class="action-card-icon bg-gradient-to-r from-purple-500 to-violet-600">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                                </svg>
                            </div>
                            <h3 class="action-card-title"><%= t('common.tournaments') %></h3>
                            <p class="action-card-desc"><%= t('common.competeForGlory') %></p>
                        </a>

                        <!-- Mi Perfil -->
                        <a href="/profile" class="action-card group">
                            <div class="action-card-icon bg-gradient-to-r from-blue-500 to-cyan-600">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <h3 class="action-card-title"><%= t('common.myProfile') %></h3>
                            <p class="action-card-desc"><%= t('common.viewStats') %></p>
                        </a>

                        <!-- Editar Perfil -->
                        <a href="/editprofile" class="action-card group">
                            <div class="action-card-icon bg-gradient-to-r from-orange-500 to-red-600">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                            </div>
                            <h3 class="action-card-title"><%= t('common.configure') %></h3>
                            <p class="action-card-desc"><%= t('common.editProfileDesc') %></p>
                        </a>
                    </div>

                    <!-- Stats del usuario -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                        <div class="stats-card">
                            <div class="text-3xl font-bold text-gradient mb-2"><%= user.wins || 0 %></div>
                            <div class="text-white/60 text-sm"><%= t('common.wins') %></div>
                        </div>
                        <div class="stats-card">
                            <div class="text-3xl font-bold text-gradient mb-2"><%= user.losses || 0 %></div>
                            <div class="text-white/60 text-sm"><%= t('common.losses') %></div>
                        </div>
                        <div class="stats-card">
                            <div class="text-3xl font-bold text-gradient mb-2"><%= user.level || 1 %></div>
                            <div class="text-white/60 text-sm"><%= t('common.level') %></div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>


    <!-- JavaScript para efectos interactivos -->
    <script src="/public/js/landing.js"></script>
</body>
</html>