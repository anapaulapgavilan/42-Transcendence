<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : t('common.gameTitle') %></title>

    <!-- FAVICON -->
    <link rel="icon" type="image/svg+xml" href="./public/favicon.svg">

    <!-- CSS compilado por Tailwind -->
   <link href="/public/styles.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="h-full overflow-hidden font-poppins">
    <!-- Fondo con gradiente y mesh -->
    <div class="fixed inset-0 z-0">
        <!-- Gradiente base -->
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900"></div>

        <!-- Gradiente vibrante -->
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-pink-500/30 to-blue-600/20 bg-mesh-pattern opacity-80"></div>

        <!-- Overlay oscuro para mejor contraste -->
        <div class="absolute inset-0 bg-black/20"></div>

        <!-- Partículas flotantes -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-[25%] left-[25%] w-2 h-2 rounded-full bg-purple-500 opacity-60 animate-float"></div>
            <div class="absolute top-[75%] right-[25%] w-1 h-1 rounded-full bg-pink-500 opacity-40 animate-float [animation-delay:2s]"></div>
            <div class="absolute top-[50%] left-[75%] w-3 h-3 rounded-full bg-blue-500 opacity-30 animate-float [animation-delay:4s]"></div>
            <div class="absolute top-[33%] right-[33%] w-1.5 h-1.5 rounded-full bg-amber-500 opacity-50 animate-float [animation-delay:6s]"></div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="relative z-10 h-full flex flex-col">
        <!-- Header/Navbar -->


        <!-- Contenido principal centrado -->
        <main class="flex-1 flex items-center justify-center px-6">
            <div class="text-center max-w-4xl mx-auto">
                <!-- Language Switcher -->
                <div class="absolute top-6 right-6">
                    <%- include('components/languageSwitcher') %>
                </div>

                <!-- Subtítulo -->
                <div class="mb-6">
                    <span class="inline-block px-4 py-2 rounded-full text-orange-300 text-sm font-medium bg-white/5 backdrop-blur-lg border border-white/20 shadow-neon animate-pulse">
                        <%= t('common.gameTitle') %>
                    </span>
                </div>

                <!-- Título principal -->
                <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-black mb-8 leading-tight">
                    <span class="block bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron tracking-tight">
                        <%= t('landing.title') %>
                    </span>
                </h1>

                <!-- Botones de acción -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <!-- Botón Sign Up -->
                    <a href="/signup">
                        <button id="signupBtn" class="group relative px-8 py-4 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 overflow-hidden bg-gradient-to-r from-orange-500 to-orange-600 hover:-translate-y-1 hover:shadow-[0_25px_50px_-12px_rgba(249,115,22,0.25)] animate-glow">
                            <span class="absolute inset-0 bg-gradient-to-r from-orange-600 to-red-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                            <span class="relative z-10"><%= t('landing.signup') %></span>
                        </button>
                    </a>

                    <!-- Botón Login -->
                    <a href="/login">
                        <button id="loginBtn" class="group relative px-8 py-4 text-white font-semibold rounded-xl transition-all duration-300 bg-white/5 backdrop-blur-lg border border-white/20 shadow-neon hover:bg-white/10 hover:-translate-y-1">
                            <span class="relative z-10"><%= t('landing.login') %></span>
                        </button>
                    </a>
                </div>
            </div>
        </main>
    </div>

    <!-- JavaScript -->
    <script src="/public/js/landing.js"></script>
</body>
</html>
