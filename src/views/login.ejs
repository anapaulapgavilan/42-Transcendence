<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title>Login - ft_transcendence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Google Sign-In -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>

    <!-- FAVICON -->
    <link rel="icon" type="image/svg+xml" href="./public/favicon.svg">
    
    <!-- CSS compilado por Tailwind -->
    <link href="/public/styles.css" rel="stylesheet" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="h-full overflow-hidden font-poppins">
    <!-- Fondo con gradiente y mesh -->
    <div class="fixed inset-0 z-0">
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-pink-500/30 to-blue-600/20 bg-mesh-pattern opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-[25%] left-[25%] w-2 h-2 rounded-full bg-purple-500 opacity-60 animate-float"></div>
            <div class="absolute top-[75%] right-[25%] w-1 h-1 rounded-full bg-pink-500 opacity-40 animate-float [animation-delay:2s]"></div>
            <div class="absolute top-[50%] left-[75%] w-3 h-3 rounded-full bg-blue-500 opacity-30 animate-float [animation-delay:4s]"></div>
            <div class="absolute top-[33%] right-[33%] w-1.5 h-1.5 rounded-full bg-amber-500 opacity-50 animate-float [animation-delay:6s]"></div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="relative z-10 h-full flex flex-col">

        <!-- Language Switcher -->
        <div class="absolute top-6 right-6">
            <%- include('components/languageSwitcher') %>
        </div>

        <!-- Contenido principal centrado -->
        <main class="flex-1 flex items-center justify-center px-6 py-12">
            <div class="w-full max-w-md">
                <!-- Container con efecto glass -->
                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp max-w-md mx-auto">
                    <!-- Header del login -->
                    <div class="text-center mb-8">
                        <h1 class="text-3xl font-bold bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron mb-2">
                            <%= typeof t !== 'undefined' ? t('login.welcome') : 'Bienvenido' %>
                        </h1>
                        <p class="text-white/70 text-sm">
                            <%= typeof t !== 'undefined' ? t('login.continueAdventure') : 'Inicia sesión para continuar la aventura' %>
                        </p>
                    </div>

                    <!-- Formulario de login local -->
                    <form method="POST" action="/login" class="space-y-6">
                        <!-- Campo Email -->
                        <div class="space-y-3 mb-6">
                            <label for="mail" class="block text-sm font-medium text-white/90 mb-2 ml-1">
                                <%= typeof t !== 'undefined' ? t('login.email') : 'Email' %>
                            </label>
                            <input 
                                type="email" 
                                name="mail" 
                                id="mail" 
                                required 
                                class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] focus-visible:outline-2 focus-visible:outline-purple-400/80 focus-visible:outline-offset-2 valid:border-green-600/60 invalid:not-(:placeholder-shown):border-red-500/60"
                                placeholder="<%= typeof t !== 'undefined' ? t('login.emailPlaceholder') : 'tu@email.com' %>"
                            />
                        </div>

                        <!-- Campo Password -->
                        <div class="space-y-3 mb-6">
                            <label for="password" class="block text-sm font-medium text-white/90 mb-2 ml-1">
                                <%= typeof t !== 'undefined' ? t('login.password') : 'Password' %>
                            </label>
                            <input 
                                type="password" 
                                name="password" 
                                id="password" 
                                required 
                                class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-base transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] focus-visible:outline-2 focus-visible:outline-purple-400/80 focus-visible:outline-offset-2 valid:border-green-600/60 invalid:not-(:placeholder-shown):border-red-500/60"
                                placeholder="<%= typeof t !== 'undefined' ? t('login.passwordPlaceholder') : '••••••••' %>"
                            />
                        </div>

                        <!-- Botón Login -->
                        <button type="submit" class="group relative px-8 py-4 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 overflow-hidden bg-gradient-to-r from-orange-500 to-orange-600 hover:-translate-y-1 hover:shadow-[0_25px_50px_-12px_rgba(249,115,22,0.25)] animate-glow w-full">
                            <span class="absolute inset-0 bg-gradient-to-r from-orange-600 to-red-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                            <span class="relative z-10"><%= typeof t !== 'undefined' ? t('login.loginButton') : 'Iniciar Sesión' %></span>
                        </button>
                    </form>

                    <!-- Separador -->
                    <div class="flex items-center justify-center my-8 px-4">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent min-w-[40px]"></div>
                        <span class="px-6 text-sm text-white/60 font-medium text-center whitespace-nowrap flex-shrink-0"><%= typeof t !== 'undefined' ? t('login.orContinueWith') : 'o continúa con' %></span>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent min-w-[40px]"></div>
                    </div>

                    <!-- Google Sign-In -->
                    <div class="w-full flex justify-center items-center m-0">
                        <div
                            id="g_id_onload"
                            data-client_id="<%= googleClientId %>"
                            data-callback="handleGoogleLogin"
                            data-auto_prompt="false"
                        ></div>
                        <div
                            class="g_id_signin w-full flex justify-center items-center"
                            data-type="standard"
                            data-size="large"
                            data-theme="filled_blue"
                            data-text="signin_with"
                            data-shape="rectangular"
                            data-logo_alignment="left"
                            data-width="100%"
                        ></div>
                    </div>

                    <!-- Links adicionales -->
                    <div class="text-center mt-6 space-y-2">
                        <p class="text-white/60 text-sm">
                            <%= typeof t !== 'undefined' ? t('login.noAccount') : '¿No tienes cuenta?' %> 
                            <a href="/signup" class="text-orange-400 hover:text-orange-300 transition-colors font-medium">
                                <%= typeof t !== 'undefined' ? t('login.registerHere') : 'Regístrate aquí' %>
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </main>

    </div>

    <!-- JavaScript para Google Login -->
    <script>
        async function handleGoogleLogin(response) {
            const token = response.credential;
            try {
                const res = await fetch('/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ googleToken: token }),
                });
                if (res.redirected) {
                    window.location.href = res.url;
                } else {
                    alert('Google login failed');
                }
            } catch (err) {
                alert('An error occurred during Google login');
                console.error(err);
            }
        }
    </script>

    <!-- JavaScript para efectos interactivos -->
    <script src="/public/js/landing.js"></script>
</body>
</html>
