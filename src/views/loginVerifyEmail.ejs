<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title>Verificar Acceso por Email - ft_transcendence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">

    <link href="/public/styles.css" rel="stylesheet" />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-full font-poppins edit-profile-page"> 
    
    <div class="absolute inset-0 z-0 min-h-screen">
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-pink-500/30 to-blue-600/20 bg-mesh opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute inset-0">
            <div class="floating-particle particle-1"></div>
            <div class="floating-particle particle-2"></div>
            <div class="floating-particle particle-3"></div>
            <div class="floating-particle particle-4"></div>
        </div>
    </div>

    <div class="relative z-10 min-h-screen flex items-center justify-center px-6 py-8">
        <!-- Language Switcher -->
        <div class="absolute top-6 right-6">
            <%- include('components/languageSwitcher') %>
        </div>
        
        <div class="w-full max-w-md">

            <div class="glass-container max-w-md mx-auto text-center">

                <div class="mb-8">
                    <h1 class="text-3xl font-black text-gradient font-orbitron mb-2">
                        <%= typeof t !== 'undefined' ? t('loginVerifyEmail.emailVerification') : 'Verificación por Email' %>
                    </h1>
                    <p class="text-white/70 text-base">
                        <%= typeof t !== 'undefined' ? t('loginVerifyEmail.enterEmailCode') : 'Ingresa el código que enviamos a tu dirección de correo electrónico.' %>
                    </p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <%= error %>
                    </div>
                <% } %>

                <form action="/loginVerifyEmail" method="POST" class="space-y-6">
                    <div class="form-group">
                        <label for="code" class="form-label text-center block">
                            <%= typeof t !== 'undefined' ? t('loginVerifyEmail.accessCode') : 'Código de Acceso' %>
                        </label>
                        <input
                            type="text"
                            id="code"
                            name="code"
                            class="form-input text-center text-lg tracking-widest font-mono"
                            placeholder="<%= typeof t !== 'undefined' ? t('loginVerifyEmail.codePlaceholder') : '••••••' %>"
                            maxlength="6"
                            required
                            autocomplete="off"
                            autofocus
                        />
                    </div>
                    
                    <button type="submit" class="btn-primary w-full group">
                        <span class="relative z-10"><%= typeof t !== 'undefined' ? t('loginVerifyEmail.verify') : 'Verificar' %></span>
                    </button>
                    
                    <div class="text-center pt-2">
                        <p class="text-white/60 text-sm">
                            <a href="/login" class="text-red-400 hover:text-red-300 transition-colors font-medium">
                                ¿No es tu cuenta? Volver a Iniciar Sesión.
                            </a>
                        </p>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="/public/js/landing.js"></script>
</body>
</html>