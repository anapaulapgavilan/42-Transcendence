<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">

<head>
    <meta charset="UTF-8" />
    <title>Perfil - ft_transcendence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />


    <link href="/public/styles.css" rel="stylesheet" />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-screen font-poppins bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 bg-fixed overflow-y-auto overflow-x-hidden">
    <!-- Fondo fijo con mesh -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-mesh-pattern bg-400 opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col">
        <header class="p-6 bg-white/5 backdrop-blur-lg border border-white/20">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <div class="flex items-center space-x-2">
                    <div
                        class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg">ft_transcendence</span>
                </div>

                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></span>
                    </a>

                    <a href="/profile" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></span>
                    </a>

                    <a href="/game" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></span>
                    </a>

                    <a href="/tournament" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></span>
                    </a>
                </div>

                <div class="flex items-center space-x-4">
                    <div class="hidden sm:block">
                        <%- include('components/languageSwitcher') %>
                    </div>
                    
                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium">
                                <%= user.alias %>
                            </p>
                            <p class="text-white/60 text-xs"><%= typeof t !== 'undefined' ? t('profile.level') : 'Nivel' %> <%= (Math.floor((user.wins + user.looses) / 5) + 1) %></p>
                        </div>
                        <div
                            class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">
                                <%= user.alias.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <button onclick="logout()" class="p-2 rounded-lg text-white/80 hover:text-white transition-all duration-300 hover:bg-red-500/20 hover:border hover:border-red-500/40 hover:scale-110 hover:shadow-[0_4px_15px_rgba(239,68,68,0.3)]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                            </path>
                        </svg>
                    </button>
                </div>

                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></a>
                    <a href="/profile" class="block px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300"><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></a>
                    <a href="/game" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></a>
                    <a href="/tournament" class="block px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 hover:bg-white/10 hover:scale-[1.02]"><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>

        <main class="flex-1 px-6 py-8">
            <div class="w-full max-w-6xl mx-auto space-y-8">

                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp">
                    <div
                        class="flex flex-col md:flex-row items-center md:items-start space-y-6 md:space-y-0 md:space-x-8">
                        <div class="relative">
                            <div class="w-32 h-32 rounded-full border-4 border-white/20 overflow-hidden relative bg-gradient-to-br from-purple-500 via-pink-500 to-amber-500 transition-all duration-300 hover:scale-105 hover:border-white/40 hover:shadow-[0_0_30px_rgba(168,85,247,0.5)]">
                                <% if (user.avatar_url) { %>
                                    <img src="<%= user.avatar_url %>" alt="Avatar" class="w-full h-full object-cover" />
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-500 to-pink-500">
                                            <span class="text-4xl font-bold text-white">
                                                <%= user.alias.charAt(0).toUpperCase() %>
                                            </span>
                                        </div>
                                        <% } %>
                            </div>
                            <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-green-500 rounded-full border-4 border-white/20 animate-pulse"></div>
                        </div>

                        <div class="flex-1 text-center md:text-left">
                            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black mb-2">
                                <span class="bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron">
                                    <%= user.alias %>
                                </span>
                            </h1>
                            <p class="text-white/70 text-lg mb-4">
                                <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207">
                                    </path>
                                </svg>
                                <%= user.mail %>
                            </p>

                            <div class="flex flex-col sm:flex-row gap-3">
                                <a href="/editprofile" class="flex items-center space-x-2 px-6 py-3 rounded-xl font-semibold transition-all duration-300 bg-gradient-to-r from-orange-500 to-orange-600 text-white scale-100 hover:scale-105 hover:shadow-[0_8px_25px_rgba(249,115,22,0.4)] animate-glow">
                                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                        </path>
                                    </svg>
                                    <%= typeof t !== 'undefined' ? t('profile.editProfile') : 'Editar Perfil' %>
                                </a>
                                <a href="/friends" class="flex items-center space-x-2 px-6 py-3 rounded-xl font-semibold transition-all duration-300 bg-white/10 text-white border border-white/20 backdrop-blur-lg scale-100 hover:scale-105 hover:bg-white/15 hover:border-white/40">
                                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                        <path
                                            d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z">
                                        </path>
                                    </svg>
                                    <%= typeof t !== 'undefined' ? t('profile.friends') : 'Amigos' %>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6">
                    <div class="p-6 rounded-2xl backdrop-blur-lg border border-white/20 bg-white/5 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] scale-100 hover:scale-105 hover:bg-white/[0.08] hover:border-white/40 hover:shadow-[0_0_30px_rgba(34,197,94,0.3)] animate-fadeInUp-delay-1">
                        <div class="flex items-center space-x-3 mb-4">
                            <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z">
                                </path>
                            </svg>
                            <span class="text-white/80 font-medium"><%= typeof t !== 'undefined' ? t('profile.wins') : 'Victorias' %></span>
                        </div>
                        <div class="text-3xl font-bold font-orbitron text-green-400">
                            <%= user.wins %>
                        </div>
                    </div>

                    <div class="p-6 rounded-2xl backdrop-blur-lg border border-white/20 bg-white/5 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] scale-100 hover:scale-105 hover:bg-white/[0.08] hover:border-white/40 hover:shadow-[0_0_30px_rgba(239,68,68,0.3)] animate-fadeInUp-delay-2">
                        <div class="flex items-center space-x-3 mb-4">
                            <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            <span class="text-white/80 font-medium"><%= typeof t !== 'undefined' ? t('profile.losses') : 'Derrotas' %></span>
                        </div>
                        <div class="text-3xl font-bold font-orbitron text-red-400">
                            <%= user.looses %>
                        </div>
                    </div>
                </div>
                
                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp-delay-3">
                    <div class="mb-6">
                        <h2 class="text-2xl font-bold bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron mb-6">
                            <svg class="w-6 h-6 inline mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('profile.matchHistory') : 'Historial de Partidas' %>
                        </h2>
                    </div>

                    <% if (matchHistory && matchHistory.length> 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% matchHistory.forEach(match=> { %>
                                <% 
                                const pendingText = typeof t !== 'undefined' ? t('profile.pending') : 'Pendiente';
                                const victoryText = typeof t !== 'undefined' ? t('profile.victory') : 'Victoria';
                                const defeatText = typeof t !== 'undefined' ? t('profile.defeat') : 'Derrota';
                                
                                let matchClass = 'border-yellow-500/30 bg-[rgba(234,179,8,0.1)]';
                                let statusIcon = 'clock';
                                let statusText = pendingText;
                                let statusColor = 'text-yellow-400';
                                
                                if (match.finished) {
                                    if (match.winner === user.id) {
                                        matchClass = 'border-green-500/30 bg-[rgba(34,197,94,0.1)]';
                                        statusIcon = 'check';
                                        statusText = victoryText;
                                        statusColor = 'text-green-400';
                                    } else {
                                        matchClass = 'border-red-500/30 bg-[rgba(239,68,68,0.1)]';
                                        statusIcon = 'x';
                                        statusText = defeatText;
                                        statusColor = 'text-red-400';
                                    }
                                }
                                %>

                                <div class="p-4 rounded-xl backdrop-blur-lg border transition-all duration-300 scale-100 hover:scale-[1.02] hover:bg-white/[0.08] cursor-pointer <%= matchClass %>">
                                    <div class="flex justify-between items-center mb-4">
                                        <div class="flex items-center space-x-2 font-medium <%= statusColor %>">
                                            <% if (statusIcon === 'check') { %>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                            <% } else if (statusIcon === 'x') { %>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                                </svg>
                                            <% } else { %>
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z">
                                                    </path>
                                                </svg>
                                            <% } %>
                                            <span><%= statusText %></span>
                                        </div>
                                        <div class="text-white/60 text-sm">
                                            <%= new Date(match.created_at).toLocaleDateString('es-ES') %>
                                        </div>
                                    </div>

                                    <div class="flex items-center justify-between">
                                        <div class="flex flex-col items-center space-y-1 <%= match.alias_user1 === user.alias ? 'text-orange-400 font-semibold' : '' %>">
                                            <span class="text-white/90 font-medium text-sm">
                                                <%= match.alias_user1 %>
                                            </span>
                                            <span class="text-2xl font-bold bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent">
                                                <%= match.points_user1 || 0 %>
                                            </span>
                                        </div>

                                        <div class="text-white/60 font-bold text-sm">VS</div>

                                        <div class="flex flex-col items-center space-y-1 <%= match.alias_user2 === user.alias ? 'text-orange-400 font-semibold' : '' %>">
                                            <span class="text-white/90 font-medium text-sm">
                                                <%= match.alias_user2 %>
                                            </span>
                                            <span class="text-2xl font-bold bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent">
                                                <%= match.points_user2 || 0 %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="py-12 text-center">
                            <svg class="w-16 h-16 text-white/30 mx-auto mb-4" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                                </path>
                            </svg>
                            <p class="text-white/60 text-center">
                                <%= typeof t !== 'undefined' ? t('profile.noMatches') : 'No hay partidas registradas aún.' %>
                                <br>
                                <a href="/game"
                                    class="text-orange-400 hover:text-orange-300 transition-colors"><%= typeof t !== 'undefined' ? t('profile.playFirstGame') : '¡Juega tu primera partida!' %></a>
                            </p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <script src="/public/js/landing.js"></script>
</body>

</html>
