<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title>Configurar 2FA - ft_transcendence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">

    <link href="/public/styles.css" rel="stylesheet" />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-screen font-poppins bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 bg-fixed overflow-y-auto overflow-x-hidden"> 
    
    <!-- Fondo fijo con mesh -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-mesh-pattern bg-400 opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <div class="relative z-10 min-h-screen flex items-center justify-center px-6 py-12">
        <!-- Language Switcher -->
        <div class="absolute top-6 right-6 z-50">
            <%- include('components/languageSwitcher') %>
        </div>
        
        <div class="w-full max-w-2xl">

            <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp text-center">

                <div class="mb-12">
                    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black leading-tight mb-4">
                        <span class="block bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron tracking-tight">
                            🔐 <%= typeof t !== 'undefined' ? t('setup2fa.title') : 'CONFIGURAR 2FA' %>
                        </span>
                    </h1>
                    <p class="text-white/70 text-lg mt-4">
                        <%= typeof t !== 'undefined' ? t('setup2fa.scanCode') : 'Escanea el código para habilitar la autenticación.' %>
                    </p>
                </div>

                <div class="space-y-6 mb-8 p-6 rounded-2xl bg-white/5 border border-white/10">
                    <div class="flex items-center justify-center space-x-3 mb-4">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-purple-500 to-purple-600 flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white"><%= typeof t !== 'undefined' ? t('setup2fa.step1') : '1. Escanea el Código' %></h3>
                    </div>

                    <div class="flex justify-center p-6 bg-white/10 rounded-xl border border-white/20 shadow-lg">
                        <img src="<%= qrCode %>" alt="2FA QR Code" class="w-48 h-48 sm:w-56 sm:h-56 object-contain">
                    </div>

                    <p class="text-white/70 text-base pt-2">
                        <%= typeof t !== 'undefined' ? t('setup2fa.cantScan') : 'Si no puedes escanearlo, ingresa este código manualmente:' %>
                    </p>
                    <div class="bg-white/10 text-yellow-400 font-mono p-4 rounded-xl inline-block text-base sm:text-lg transition-all duration-300 border border-yellow-500/30">
                        <%= secret %>
                    </div>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <%= error %>
                    </div>
                <% } %>
                
                <form action="/verify2fa" method="POST" class="space-y-6 pt-6 border-t border-white/10">
                    <div class="space-y-6 p-6 rounded-2xl bg-white/5 border border-white/10">
                        <div class="flex items-center justify-center space-x-3 mb-4">
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-green-500 to-emerald-600 flex items-center justify-center flex-shrink-0">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <h3 class="text-2xl font-bold text-white"><%= typeof t !== 'undefined' ? t('setup2fa.step2') : '2. Ingresa el Código' %></h3>
                        </div>

                        <div class="space-y-3">
                            <label for="token" class="block text-base font-medium text-white/90 text-center">
                                <%= typeof t !== 'undefined' ? t('setup2fa.appCode') : 'Código de tu App' %>
                            </label>
                            <input
                                type="text"
                                id="token"
                                name="token"
                                class="w-full px-5 py-4 rounded-xl border border-white/20 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-400/30 bg-white/5 backdrop-blur-lg text-white text-lg transition-all duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] placeholder:text-white/40 hover:border-purple-400/40 hover:bg-white/[0.06] focus:bg-white/[0.08] focus:-translate-y-px focus:shadow-[0_4px_20px_rgba(168,85,247,0.3)] focus-visible:outline-2 focus-visible:outline-purple-400/80 focus-visible:outline-offset-2 text-center tracking-widest font-mono"
                                placeholder="<%= typeof t !== 'undefined' ? t('setup2fa.codePlaceholder') : '••••••' %>"
                                maxlength="6"
                                required
                                autocomplete="off"
                                autofocus
                            />
                        </div>
                    </div>
                    
                    <button type="submit" class="group relative px-8 py-4 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 overflow-hidden bg-gradient-to-r from-orange-500 to-orange-600 hover:-translate-y-1 hover:shadow-[0_25px_50px_-12px_rgba(249,115,22,0.25)] animate-glow w-full whitespace-nowrap">
                        <span class="relative z-10 flex items-center justify-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('setup2fa.verifyAndActivate') : 'Verificar y Activar 2FA' %>
                        </span>
                    </button>

                    <div class="text-center pt-2">
                        <a href="/editprofile" class="text-white/60 hover:text-white transition-colors text-base inline-flex items-center">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                            <%= typeof t !== 'undefined' ? t('setup2fa.cancelAndReturn') : 'Cancelar y volver al perfil' %>
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="/public/js/landing.js"></script>
</body>
</html>