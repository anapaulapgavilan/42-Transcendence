<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title>Configurar 2FA - ft_transcendence</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">

    <link href="/public/styles.css" rel="stylesheet" />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">
</head>

<body class="min-h-full font-poppins edit-profile-page"> 
    
    <div class="absolute inset-0 z-0 min-h-screen">
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-pink-500/30 to-blue-600/20 bg-mesh opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute inset-0">
            <div class="floating-particle particle-1"></div>
            <div class="floating-particle particle-2"></div>
            <div class="floating-particle particle-3"></div>
            <div class="floating-particle particle-4"></div>
        </div>
    </div>

    <div class="relative z-10 min-h-screen flex items-center justify-center px-6 py-8">
        <!-- Language Switcher -->
        <div class="absolute top-6 right-6">
            <%- include('components/languageSwitcher') %>
        </div>
        
        <div class="w-full max-w-md">

            <div class="glass-container max-w-md mx-auto text-center">

                <div class="mb-8">
                    <h1 class="text-3xl font-black text-gradient font-orbitron mb-2">
                        <%= typeof t !== 'undefined' ? t('setup2fa.title') : 'Configurar 2FA' %>
                    </h1>
                    <p class="text-white/70 text-base">
                        <%= typeof t !== 'undefined' ? t('setup2fa.scanCode') : 'Escanea el código para habilitar la autenticación.' %>
                    </p>
                </div>

                <div class="form-section space-y-4 mb-8">
                    <div class="section-header justify-center">
                        <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                        <h3 class="section-title"><%= typeof t !== 'undefined' ? t('setup2fa.step1') : '1. Escanea el Código' %></h3>
                    </div>

                    <div class="flex justify-center p-4 bg-white/5 rounded-xl  shadow-lg">
                        <img src="<%= qrCode %>" alt="2FA QR Code" class="w-48 h-48 sm:w-56 sm:h-56 object-contain">
                    </div>

                    <p class="text-white/70 text-sm pt-2">
                        <%= typeof t !== 'undefined' ? t('setup2fa.cantScan') : 'Si no puedes escanearlo, ingresa este código manualmente:' %>
                    </p>
                    <p class="bg-white/10 text-yellow-400 font-mono p-3 rounded-lg inline-block text-sm sm:text-base  transition-all duration-300">
                        <%= secret %>
                    </p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message">
                        <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <%= error %>
                    </div>
                <% } %>
                
                <form action="/verify2fa" method="POST" class="space-y-6 pt-4 border-t border-white/10">
                    <div class="form-section space-y-4">
                        <div class="section-header justify-center">
                            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <h3 class="section-title"><%= typeof t !== 'undefined' ? t('setup2fa.step2') : '2. Ingresa el Código' %></h3>
                        </div>

                        <div class="form-group">
                            <label for="token" class="form-label text-center block">
                                <%= typeof t !== 'undefined' ? t('setup2fa.appCode') : 'Código de tu App' %>
                            </label>
                            <input
                                type="text"
                                id="token"
                                name="token"
                                class="form-input text-center text-lg tracking-widest font-mono"
                                placeholder="<%= typeof t !== 'undefined' ? t('setup2fa.codePlaceholder') : '••••••' %>"
                                maxlength="6"
                                required
                                autocomplete="off"
                                autofocus
                            />
                        </div>
                    </div>
                    
                    <button type="submit" class="btn-primary w-full group">
                        <span class="relative z-10"><%= typeof t !== 'undefined' ? t('setup2fa.verifyAndActivate') : 'Verificar y Activar 2FA' %></span>
                    </button>

                    <div class="text-center pt-2">
                        <a href="/editprofile" class="text-white/60 hover:text-white transition-colors text-sm">
                            <%= typeof t !== 'undefined' ? t('setup2fa.cancelAndReturn') : 'Cancelar y volver al perfil' %>
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="/public/js/landing.js"></script>
</body>
</html>