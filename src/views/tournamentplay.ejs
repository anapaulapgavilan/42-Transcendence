<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">
<head>
    <meta charset="UTF-8" />
    <title><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneo' %> - <%= typeof t !== 'undefined' ? t('common.gameTitle') : 'ft_transcendence' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
    <link href="/public/styles.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen font-poppins bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 bg-fixed overflow-y-auto overflow-x-hidden">
    <!-- Fondo fijo con mesh -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 bg-mesh-pattern bg-400 opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col">
        <!-- Header/Navbar -->
        <header class="p-6 bg-white/5 backdrop-blur-lg border border-white/20">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <!-- Logo -->
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg">ft_transcendence</span>
                </div>

                <!-- Navegación Principal -->
                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 scale-100 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></span>
                    </a>

                    <a href="/profile" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 scale-100 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></span>
                    </a>

                    <a href="/game" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white/80 hover:text-white transition-all duration-300 scale-100 hover:bg-white/10 hover:scale-[1.02]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></span>
                    </a>

                    <a href="/tournament" class="flex items-center space-x-2 px-4 py-2 rounded-xl text-white bg-white/20 border border-white/30 shadow-[0_0_20px_rgba(168,85,247,0.3)] animate-subtle-pulse transition-all duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></span>
                    </a>
                </div>

                <!-- Usuario y Logout -->
                <div class="flex items-center space-x-4">
                    <!-- Language Switcher -->
                    <div class="hidden sm:block">
                        <%- include('components/languageSwitcher') %>
                    </div>

                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium">
                                <%= user.alias %>
                            </p>
                            <p class="text-white/60 text-xs"><%= typeof t !== 'undefined' ? t('profile.level') : 'Nivel' %> <%= (Math.floor((user.wins + user.looses) / 5) + 1) %></p>
                        </div>
                        <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">
                                <%= user.alias.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <button onclick="logout()" class="p-2 rounded-lg text-white/80 hover:text-white hover:bg-red-500/20 border border-transparent hover:border-red-500/40 transition-all duration-300 scale-100 hover:scale-110 hover:shadow-[0_4px_15px_rgba(239,68,68,0.3)]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                            </path>
                        </svg>
                    </button>
                </div>

                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></a>
                    <a href="/profile" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></a>
                    <a href="/game" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></a>
                    <a href="/tournament" class="mobile-nav-item active"><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>

        <!-- Contenido principal -->
        <main class="flex-1 flex items-center justify-center px-6 py-12">
            <div class="w-full max-w-7xl mx-auto">
                <!-- Container principal con glass effect (igual que home) -->
                <div class="p-8 rounded-3xl backdrop-blur-lg border border-white/20 w-full bg-white/[0.08] shadow-glass transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] relative animate-fadeInUp">
                    
                    <!-- Título -->
                    <div class="text-center mb-12">
                        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight">
                            <span class="block bg-gradient-to-r from-purple-500 via-pink-500 via-amber-500 via-emerald-500 to-blue-500 bg-[length:300%_300%] animate-gradient-shift bg-clip-text text-transparent font-orbitron tracking-tight">
                                🏆 <%= typeof t !== 'undefined' ? t('tournamentplay.title') : 'Torneo' %>
                            </span>
                        </h1>
                    </div>

                    <!-- Mensaje de ganador o estado -->
                    <% if (winner) { %>
                        <div class="mb-8 p-6 rounded-xl bg-green-500/10 border border-green-500/30 backdrop-blur-lg">
                            <h2 class="text-3xl font-bold text-green-400 flex items-center justify-center">
                                <svg class="w-8 h-8 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <%= typeof t !== 'undefined' ? t('tournamentplay.tournamentWinner') : '¡El ganador del torneo es' %> <%= winner %>! 🎉
                            </h2>
                        </div>
                    <% } else { %>
                        <div class="mb-8">
                            <h2 class="text-2xl font-bold text-white/90 flex items-center justify-center">
                                <svg class="w-6 h-6 mr-2 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                                </svg>
                                <%= typeof t !== 'undefined' ? t('tournamentplay.tournamentBracket') : 'Cuadro del Torneo' %>
                            </h2>
                        </div>
                    <% } %>

                    <!-- Bracket del torneo -->
                    <div class="flex flex-col md:flex-row overflow-x-auto pb-5 gap-6">
                        <% Object.keys(matchesByRound).sort((a, b) => parseInt(a) - parseInt(b)).forEach(roundNum => { %>
                            <div class="flex-shrink-0 min-w-[280px]">
                                <h3 class="text-xl font-semibold text-orange-400 mb-4">
                                    <%= typeof t !== 'undefined' ? t('tournamentplay.round') : 'Ronda' %> <%= roundNum %>
                                </h3>
                                <div class="space-y-4">
                                    <% matchesByRound[roundNum].forEach(match => { %>
                                        <div class="p-4 rounded-xl bg-white/5 backdrop-blur-lg border border-white/20 hover:bg-white/8 hover:border-white/30 transition-all duration-300">
                                            <div class="mb-3">
                                                <div class="flex items-center justify-center space-x-2 text-lg">
                                                    <span class="font-medium text-purple-300"><%= match.player1_alias %></span>
                                                    <span class="text-white/60">vs</span> 
                                                    <span class="font-medium text-purple-300"><%= match.player2_alias %></span>
                                                </div>
                                            </div>
                                            <div class="pt-2 border-t border-white/10">
                                                <% if (match.winner_alias) { %>
                                                    <div class="flex items-center justify-center text-green-400 font-semibold">
                                                        <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                                        </svg>
                                                        <%= typeof t !== 'undefined' ? t('tournamentplay.winner') : 'Ganador' %>: <%= match.winner_alias %>
                                                    </div>
                                                <% } else if (match.player1_id && match.player2_id) { %>
                                                    <a href="/gameplay?match_id=<%= match.id %>" class="inline-flex items-center justify-center w-full px-4 py-2 bg-gradient-to-r from-purple-600 to-violet-600 hover:from-purple-700 hover:to-violet-700 text-white font-medium rounded-lg transition-all duration-300 scale-100 hover:scale-105">
                                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.26a1 1 0 001.555.832l3.197-2.132c.563-.375.563-1.155 0-1.53z"></path>
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 100-18 9 9 0 000 18z"></path>
                                                        </svg>
                                                        <%= typeof t !== 'undefined' ? t('tournamentplay.play') : 'Jugar' %>
                                                    </a>
                                                <% } else { %>
                                                    <span class="block text-center text-white/60 text-sm"><%= typeof t !== 'undefined' ? t('tournamentplay.waitingPlayer') : 'Esperando jugador...' %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    
                    <!-- Botón de volver si hay ganador -->
                    <% if (winner) { %>
                        <div class="pt-8 flex justify-center">
                            <a href="/home" class="relative px-8 py-4 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-red-600 scale-100 hover:scale-105 hover:shadow-[0_25px_50px_-12px_rgba(249,115,22,0.25)] animate-glow">
                                <span class="relative z-10"><%= typeof t !== 'undefined' ? t('tournamentplay.backToHome') : 'Volver a Home' %></span>
                            </a>
                        </div>
                    <% } %>

                </div>
            </div>
        </main>
    </div>
    
    <script src="/public/js/landing.js"></script>
    <script>
        function logout() {
            window.location.href = '/logout';
        }
    </script>
</body>
</html>
