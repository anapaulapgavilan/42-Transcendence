<!DOCTYPE html>
<html lang="<%= typeof language !== 'undefined' ? language : 'es' %>" class="h-full">

<head>
    <meta charset="UTF-8" />
    <title><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneo' %> - <%= typeof t !== 'undefined' ? t('common.gameTitle') : 'ft_transcendence' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />

    <link href="/public/styles.css" rel="stylesheet" />

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Orbitron:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet">

    </head>

<body class="min-h-full font-poppins tournament-page">
    <div class="absolute inset-0 z-0 min-h-screen">
        <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-pink-500/30 to-blue-600/20 bg-mesh opacity-80"></div>
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute inset-0">
            <div class="floating-particle particle-1"></div>
            <div class="floating-particle particle-2"></div>
            <div class="floating-particle particle-3"></div>
            <div class="floating-particle particle-4"></div>
        </div>
    </div>

    <div class="relative z-10 min-h-screen flex flex-col">
        <header class="p-6 glass-effect">
            <nav class="flex justify-between items-center max-w-7xl mx-auto">
                <div class="flex items-center space-x-2">
                    <div
                        class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg flex items-center justify-center">
                        <span class="text-white font-bold text-sm">42</span>
                    </div>
                    <span class="text-white font-semibold text-lg">ft_transcendence</span>
                </div>

                <div class="hidden md:flex items-center space-x-1">
                    <a href="/home" class="nav-menu-item">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></span>
                    </a>

                    <a href="/profile" class="nav-menu-item">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></span>
                    </a>

                    <a href="/game" class="nav-menu-item">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1.01M15 10h1.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></span>
                    </a>

                    <a href="/tournament" class="nav-menu-item active">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z">
                            </path>
                        </svg>
                        <span><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></span>
                    </a>
                </div>

                <div class="flex items-center space-x-4">
                    <!-- Language Switcher -->
                    <div class="language-switcher-container">
                        <%- include('components/languageSwitcher') %>
                    </div>

                    <div class="hidden sm:flex items-center space-x-3">
                        <div class="text-right">
                            <p class="text-white text-sm font-medium">
                                <%= user.alias %>
                            </p>
                            <p class="text-white/60 text-xs"><%= typeof t !== 'undefined' ? t('profile.level') : 'Nivel' %> <%= (Math.floor((user.wins + user.looses) / 5) + 1) %></p>
                        </div>
                        <div
                            class="w-10 h-10 bg-gradient-to-r from-orange-500 to-pink-500 rounded-full flex items-center justify-center">
                            <span class="text-white font-bold text-sm">
                                <%= user.alias.charAt(0).toUpperCase() %>
                            </span>
                        </div>
                    </div>

                    <button onclick="logout()" class="logout-btn">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                            </path>
                        </svg>
                    </button>
                </div>

                <div class="md:hidden">
                    <button class="text-white mobile-menu-btn" type="button" aria-label="Toggle menu">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <div id="mobileMenu" class="md:hidden hidden mt-4 pt-4 border-t border-white/10">
                <div class="flex flex-col space-y-2">
                    <a href="/home" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.home') : 'Home' %></a>
                    <a href="/profile" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.profile') : 'Perfil' %></a>
                    <a href="/game" class="mobile-nav-item"><%= typeof t !== 'undefined' ? t('profile.game') : 'Game' %></a>
                    <a href="/tournament" class="mobile-nav-item active"><%= typeof t !== 'undefined' ? t('profile.tournaments') : 'Torneos' %></a>
                    <div class="pt-3 border-t border-white/10">
                        <%- include('components/languageSwitcher') %>
                    </div>
                </div>
            </div>
        </header>


        <main class="flex-1 px-6 py-8">
            <div class="w-full max-w-7xl mx-auto space-y-8 tournament-container">
                        <h1 class="text-4xl sm:text-5xl font-black mb-4">
                            <span class="text-gradient font-orbitron">
                                🏆 <%= typeof t !== 'undefined' ? t('tournamentplay.title') : 'Torneo' %>
                            </span>
                        </h1>

                <% if (winner) { %>
                    <h2 class="text-3xl font-bold text-green-400 mb-6">
                        <svg class="w-8 h-8 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"></path>
                        </svg>
                        <%= typeof t !== 'undefined' ? t('tournamentplay.tournamentWinner') : '¡El ganador del torneo es' %> <%= winner %>! 🎉
                    </h2>
                    <% } else { %>
                    <h2 class="text-2xl font-bold text-white/90 mb-6">
                        <svg class="w-6 h-6 inline mr-2 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.152A1.25 1.25 0 0112 2.75l.951.598A1.25 1.25 0 0013.782 4.14l.115 1.056a1.25 1.25 0 01.696.696l1.056.115a1.25 1.25 0 001.037.771l.6.95a1.25 1.25 0 010 1.55l-.6.95a1.25 1.25 0 00-.771 1.037l-.115 1.056a1.25 1.25 0 01-.696.696l-.951.598A1.25 1.25 0 0012 21.25l-.951-.598A1.25 1.25 0 019.218 19.86l-.115-1.056a1.25 1.25 0 00-.696-.696l-1.056-.115a1.25 1.25 0 01-1.037-.771l-.6-.95a1.25 1.25 0 000-1.55l.6-.95a1.25 1.25 0 01.771-1.037l.115-1.056a1.25 1.25 0 00.696-.696l.951-.598A1.25 1.25 0 0112 2.75z"></path>
                        </svg>
                        <%= typeof t !== 'undefined' ? t('tournamentplay.tournamentBracket') : 'Cuadro del Torneo' %>
                    </h2>
                <% } %>

                <div class="bracket">
                    <% Object.keys(matchesByRound).sort((a, b) => parseInt(a) - parseInt(b)).forEach(roundNum => { %>
                        <div class="round">
                            <h3 class="text-xl font-semibold text-orange-400 mb-4"><%= typeof t !== 'undefined' ? t('tournamentplay.round') : 'Ronda' %> <%= roundNum %></h3>
                            <% matchesByRound[roundNum].forEach(match => { %>
                                <div class="match-card tournament-match-card">
                                    <div class="mb-2">
                                        <span class="font-medium text-lg text-purple-300"><%= match.player1_alias %></span> vs 
                                        <span class="font-medium text-lg text-purple-300"><%= match.player2_alias %></span>
                                    </div>
                                    <div class="pt-2 border-t border-white/10 mt-3">
                                        <% if (match.winner_alias) { %>
                                            <div class="match-status text-green-400 font-semibold flex items-center">
                                                <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                <%= typeof t !== 'undefined' ? t('tournamentplay.winner') : 'Ganador' %>: <%= match.winner_alias %>
                                            </div>
                                        <% } else if (match.player1_id && match.player2_id) { %>
                                            <a href="/gameplay?match_id=<%= match.id %>" class="tournament-play-btn">
                                                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.26a1 1 0 001.555.832l3.197-2.132c.563-.375.563-1.155 0-1.53z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 100-18 9 9 0 000 18z"></path></svg>
                                                <%= typeof t !== 'undefined' ? t('tournamentplay.play') : 'Jugar' %>
                                            </a>
                                        <% } else { %>
                                            <span class="text-white/60 text-sm"><%= typeof t !== 'undefined' ? t('tournamentplay.waitingPlayer') : 'Esperando jugador...' %></span>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% }); %>
                </div>
                
                <% if (winner) { %>
                    <div class="pt-8 flex justify-center">
                        <a href="/home" class="btn-primary">
                            <span class="relative z-10"><%= typeof t !== 'undefined' ? t('tournamentplay.backToHome') : 'Volver a Home' %></span>
                        </a>
                    </div>
                <% } %>
                </div>
        </main>
    </div>
    

    <script src="/public/js/landing.js"></script>
    <script>
        // Función de ejemplo para el botón de logout
        function logout() {
             // Lógica de logout real (ej. fetch('/logout'))
             window.location.href = '/logout';
        }
        
        // Función de menú móvil (necesaria para el header copiado del perfil)
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }
    </script>
</body>

</html>